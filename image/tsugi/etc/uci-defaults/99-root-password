#!/bin/sh
# Set the root password from the hash baked in at image build time (the token
# below is filled in by build.sh). Runs once on first boot; /etc/init.d/boot
# removes this file afterwards.
# The single quotes are deliberate - they stop the shell from expanding the '$'
# characters inside the crypt hash at runtime.
sed -i 's|^root:[^:]*:|root:@ROOT_PW_HASH@:|' /etc/shadow
exit 0
