# Wireless for the Archer C7 v2 (ath79, mac80211, swconfig).
#
# Radio paths: openwrt matches `path` as a suffix of the realpath of
# /sys/class/ieee80211/phyN/device, so only the unique tail is given here.
# phy0 is the 5 GHz ath10k card on PCIe, phy1 the 2.4 GHz ath9k MAC on the AHB
# bus (the board DTS labels its LEDs phy0tpt = 5 GHz, phy1tpt = 2.4 GHz).
#
# Same SSID and key as mon, so clients move between the two APs on their own.
# Channels are offset from mon (2.4 GHz: 1 vs 6, 5 GHz: 36 vs 52) so the APs do
# not sit on top of each other. 52 is a DFS channel, so the 5 GHz radio waits
# out the channel availability check before it starts.
#
# The PSK is baked from secrets.sed (@WIFI_PW@).

config wifi-device 'radio0'
	option type 'mac80211'
	option path '0000:00:00.0'
	option band '5g'
	option channel '52'
	option htmode 'VHT80'
	option country 'JP'

config wifi-iface 'default_radio0'
	option device 'radio0'
	option network 'lan'
	option mode 'ap'
	option ssid 'Skeletor'
	option encryption 'psk2'
	option key '@WIFI_PW@'

config wifi-device 'radio1'
	option type 'mac80211'
	option path '18100000.wmac'
	option band '2g'
	option channel '6'
	option htmode 'HT20'
	option country 'JP'

config wifi-iface 'default_radio1'
	option device 'radio1'
	option network 'lan'
	option mode 'ap'
	option ssid 'Skeletor'
	option encryption 'psk2'
	option key '@WIFI_PW@'
