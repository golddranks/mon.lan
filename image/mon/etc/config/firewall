# Firewall for an IPv6-only LAN with a dual-stack (DHCPv4 + DHCPv6-PD) WAN.
# Zones reference interfaces by name, so the stock layout applies as-is.
#
# NAT64 needs no rules here: Jool translates in the PREROUTING hook, so the
# resulting IPv4 packets are matched by the ordinary `lan` -> `wan` forwarding
# and masqueraded by the `wan` zone like any other forwarded traffic.
#
# Inbound:
#   * IPv6 forwards TCP 80/443 to the LAN zone, untouched (no NAT66). The
#     LAN prefix follows the delegation, so the rule names the zone instead of
#     host addresses: any LAN host that forms a GUA is reachable the moment it
#     listens. ban forms none. The router's own input stays closed.
#   * IPv4 terminates TCP 80/443 on the router.
#     :80 redirects to HTTPS; :443 is proxied by name to LAN hosts
#     (see /etc/nginx/stream.d). There are no IPv4 forwards to the LAN.

config defaults
	option syn_flood '1'
	option input 'REJECT'
	option output 'ACCEPT'
	option forward 'REJECT'

config zone
	option name 'lan'
	list network 'lan'
	option input 'ACCEPT'
	option output 'ACCEPT'
	option forward 'ACCEPT'

config zone
	option name 'wan'
	list network 'wan'
	list network 'wan6'
	option input 'REJECT'
	option output 'ACCEPT'
	option forward 'REJECT'
	option masq '1'
	option mtu_fix '1'

# The jail: IPv4-only, NATed to the WAN, and unable to reach the LAN - the
# forwarding policy rejects it, so only DHCP and DNS to the router are allowed.
config zone
	option name 'iot'
	list network 'iot'
	option input 'REJECT'
	option output 'ACCEPT'
	option forward 'REJECT'

# Reach into the LAN from anywhere: trusted for what it may reach, but not a
# LAN segment. It serves no DHCP, and its clients come to the router only for
# DNS, SSH and LuCI.
config zone
	option name 'vpn'
	list network 'lan_vpn'
	option input 'ACCEPT'
	option output 'ACCEPT'
	option forward 'REJECT'

# Leave the house through it: masqueraded to the WAN, and no route to the LAN.
config zone
	option name 'vpnjail'
	list network 'jail_vpn'
	option input 'REJECT'
	option output 'ACCEPT'
	option forward 'REJECT'
	option masq '1'
	option mtu_fix '1'

config forwarding
	option src 'lan'
	option dest 'wan'

config forwarding
	option src 'iot'
	option dest 'wan'

config forwarding
	option src 'vpn'
	option dest 'lan'

config forwarding
	option src 'lan'
	option dest 'vpn'

config forwarding
	option src 'vpnjail'
	option dest 'wan'

config rule
	option name 'Allow-DHCP-Renew'
	option src 'wan'
	option proto 'udp'
	option dest_port '68'
	option family 'ipv4'
	option target 'ACCEPT'

config rule
	option name 'Allow-Ping'
	option src 'wan'
	option proto 'icmp'
	option icmp_type 'echo-request'
	option family 'ipv4'
	option target 'ACCEPT'

config rule
	option name 'Allow-IGMP'
	option src 'wan'
	option proto 'igmp'
	option family 'ipv4'
	option target 'ACCEPT'

config rule
	option name 'Allow-DHCPv6'
	option src 'wan'
	option proto 'udp'
	option dest_port '546'
	option family 'ipv6'
	option target 'ACCEPT'

config rule
	option name 'Allow-IPv4-Web'
	option src 'wan'
	option proto 'tcp'
	option dest_port '80 443'
	option family 'ipv4'
	option target 'ACCEPT'

config rule
	option name 'Allow-IPv6-LAN'
	option src 'wan'
	option dest 'lan'
	option proto 'tcp'
	option dest_port '80 443'
	option family 'ipv6'
	option target 'ACCEPT'

config rule
	option name 'Allow-MLD'
	option src 'wan'
	option proto 'icmp'
	option src_ip 'fe80::/10'
	list icmp_type '130/0'
	list icmp_type '131/0'
	list icmp_type '132/0'
	list icmp_type '143/0'
	option family 'ipv6'
	option target 'ACCEPT'

config rule
	option name 'Allow-ICMPv6-Input'
	option src 'wan'
	option proto 'icmp'
	list icmp_type 'echo-request'
	list icmp_type 'echo-reply'
	list icmp_type 'destination-unreachable'
	list icmp_type 'packet-too-big'
	list icmp_type 'time-exceeded'
	list icmp_type 'bad-header'
	list icmp_type 'unknown-header-type'
	list icmp_type 'router-solicitation'
	list icmp_type 'neighbour-solicitation'
	list icmp_type 'router-advertisement'
	list icmp_type 'neighbour-advertisement'
	option limit '1000/sec'
	option family 'ipv6'
	option target 'ACCEPT'

config rule
	option name 'Allow-ICMPv6-Forward'
	option src 'wan'
	option dest '*'
	option proto 'icmp'
	list icmp_type 'echo-request'
	list icmp_type 'echo-reply'
	list icmp_type 'destination-unreachable'
	list icmp_type 'packet-too-big'
	list icmp_type 'time-exceeded'
	list icmp_type 'bad-header'
	list icmp_type 'unknown-header-type'
	option limit '1000/sec'
	option family 'ipv6'
	option target 'ACCEPT'

config rule
	option name 'Allow-Jail-DHCP'
	option src 'iot'
	option proto 'udp'
	option dest_port '67'
	option target 'ACCEPT'

config rule
	option name 'Allow-Jail-DNS'
	option src 'iot'
	option proto 'tcpudp'
	option dest_port '53'
	option target 'ACCEPT'

# WireGuard listens on one port per interface, both UDP.
config rule
	option name 'Allow-WireGuard'
	option src 'wan'
	option proto 'udp'
	option dest_port '51820 51821'
	option target 'ACCEPT'

# The jail VPN resolves names through the router and reaches nothing else of it.
config rule
	option name 'Allow-JailVPN-DNS'
	option src 'vpnjail'
	option proto 'tcpudp'
	option dest_port '53'
	option target 'ACCEPT'

# A device that pings its gateway before it will look for its cloud reads a
# rejected gateway as "no router": the doorbell retried echo requests and
# nothing else until this answered.
config rule
	option name 'Allow-Jail-Ping'
	option src 'iot'
	option proto 'icmp'
	option icmp_type 'echo-request'
	option target 'ACCEPT'
