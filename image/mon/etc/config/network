# Network configuration for GL.iNet MT6000 (Flint 2), baked into the image.
#
# Device names come from the target's board.d/02_network for `glinet,gl-mt6000`:
#   ucidef_set_interfaces_lan_wan "lan1 lan2 lan3 lan4 lan5" eth1
# so the 2.5G WAN port is `eth1` and LAN is a bridge over the remaining ports.
#
# LAN is IPv6-only:
#   * no IPv4 address on `lan`, and no DHCPv4 (see /etc/config/dhcp)
#   * the GUA is the first /64 of the delegation, so it follows the PD
#   * a ULA gives stable internal addressing independent of the delegated prefix
# IPv4 reachability from LAN hosts comes from NAT64 + DNS64; see
# /etc/config/jool (translation) and /etc/config/unbound (synthesis).

config interface 'loopback'
	option device 'lo'
	option proto 'static'
	option ipaddr '127.0.0.1'
	option netmask '255.0.0.0'

config globals 'globals'
	option ula_prefix '@ULA@::/48'
	# Set the DHCPv6 client identity to a constant, else
	# 14_network-generate-duid mints a random DUID-UUID on first boot and every
	# `sysupgrade -n` presents J:COM with a new client. DUID-LL: type 4, hardware
	# type 1 (Ethernet), eth1's MAC 94:83:c4:a6:3b:7d - well formed, so nothing
	# about the client is invalid.
	option dhcp_default_duid '000400019483c4a63b7d'

config device
	option name 'br-lan'
	option type 'bridge'
	list ports 'lan1'
	list ports 'lan2'
	list ports 'lan3'
	list ports 'lan4'
	list ports 'lan5'

config interface 'lan'
	option device 'br-lan'
	option proto 'static'
	# Take the first /64 of the delegation. Pinning the subnet id keeps the LAN
	# on one /64 if other subnets are added later; the rest of the /56 stays
	# unassigned. The prefix is never configured by hand: a GUA the ISP has
	# stopped routing is invisible to every check but a reachability probe.
	option ip6assign '64'
	option ip6hint '0'
	list ip6addr '@ULA@::1/64'

config device
	option name 'br-iot'
	option type 'bridge'

# IPv4-only by design: the jail exists for devices that cannot use this LAN's
# addressing, so it gets an address and NAT and nothing else. No ports - only
# the jail SSID on radio0 joins it.
config interface 'iot'
	option device 'br-iot'
	option proto 'static'
	option ipaddr '10.10.1.1'
	option netmask '255.255.255.0'

config interface 'wan'
	option device 'eth1'
	option proto 'dhcp'

config interface 'wan6'
	option device 'eth1'
	option proto 'dhcpv6'
	option reqaddress 'try'
	option reqprefix '56'

# --- WireGuard ---------------------------------------------------------------
# SkeletoriLanVPN: a second /64 in the same ULA, forwarded to the LAN with no
# NAT, so a client away from home reaches hosts by the names and addresses it
# uses at home. The client's AllowedIPs are the two ULA /64s only, so what wins
# at home is a client-side routing question (see README).
config interface 'lan_vpn'
	option proto 'wireguard'
	option private_key '@LAN_VPN_KEY@'
	option listen_port '51820'
	list addresses '@ULA@:1::1/64'

# SkeletoriJailVPN: IPv4 only, masqueraded to the WAN and with no route to the
# LAN. There is no IPv6 address on this interface, so a client that sends ::/0
# into the tunnel has its v6 dropped here instead of leaking it.
config interface 'jail_vpn'
	option proto 'wireguard'
	option private_key '@JAIL_VPN_KEY@'
	option listen_port '51821'
	list addresses '10.10.2.1/24'

# Peers are not listed here: one /etc/wireguard/<interface>.tsv per interface
# holds them, and /etc/uci-defaults/50-wireguard-peers adds them at first boot.
