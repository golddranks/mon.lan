# Wireless for the MT6000. Radio layout auto-detected from board.json:
#   radio0 = 2.4 GHz (platform/soc/18000000.wifi)
#   radio1 = 5 GHz   (platform/soc/18000000.wifi+1)
# (The old Archer C7 had these the other way round.)
#
# One SSID on both bands, so clients choose the band and move between them on
# their own. 802.11r (fast BSS transition) is on, with the same mobility domain
# as ban: `ft_psk_generate_local` derives the FT keys from the shared PSK, so
# the two APs only have to agree on the domain. 802.11k/v are on too; their
# neighbour reports and steering state are exchanged by usteer.
# The PSK is baked from secrets.sed (@WIFI_PW@).

config wifi-device 'radio0'
	option type 'mac80211'
	option path 'platform/soc/18000000.wifi'
	option band '2g'
	option channel '1'
	option htmode 'HE20'
	option country 'JP'

config wifi-iface 'default_radio0'
	option device 'radio0'
	option network 'lan'
	option mode 'ap'
	option ssid 'Skeletor'
	option encryption 'psk2'
	option key '@WIFI_PW@'
	option ieee80211r '1'
	option mobility_domain '@FT_MDID@'
	option ft_over_ds '1'
	option ft_psk_generate_local '1'
	option ieee80211k '1'
	option ieee80211v '1'

# The jail: IPv4-only devices that the IPv6-only LAN cannot serve. 2.4 GHz only -
# those devices are 2.4 GHz, and the 5 GHz radio stays for everything else. No
# 802.11r/802.11k/v: nothing here roams, and the PSK is its own. `isolate` drops
# station-to-station frames at the AP, which the firewall cannot do for a
# switched bridge; DHCP, DNS and NAT keep working because the AP relays them.
config wifi-iface 'jail_radio0'
	option device 'radio0'
	option network 'iot'
	option mode 'ap'
	option ssid 'SkeletorJail'
	option encryption 'psk2'
	option key '@IOT_WIFI_PW@'
	option isolate '1'

config wifi-device 'radio1'
	option type 'mac80211'
	option path 'platform/soc/18000000.wifi+1'
	option band '5g'
	option channel '36'
	option htmode 'HE80'
	option country 'JP'
	option cell_density '0'

config wifi-iface 'default_radio1'
	option device 'radio1'
	option network 'lan'
	option mode 'ap'
	option ssid 'Skeletor'
	option encryption 'psk2'
	option key '@WIFI_PW@'
	option ieee80211r '1'
	option mobility_domain '@FT_MDID@'
	option ft_over_ds '1'
	option ft_psk_generate_local '1'
	option ieee80211k '1'
	option ieee80211v '1'
