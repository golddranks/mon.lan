# LAN is IPv6-only. `dhcpv4 'disabled'` stops dnsmasq handing out IPv4 leases;
# this affects dnsmasq only. odhcpd still serves the IPv6 side (RA/SLAAC +
# DHCPv6) as configured below - odhcpd-ipv6only never serves DHCPv4.
#
# DNS: dnsmasq remains the LAN resolver (it owns the `lan` domain) but no longer
# uses the ISP resolvers - it forwards everything to unbound on loopback, which
# synthesises AAAA records for IPv4-only names (DNS64). See /etc/config/unbound.

config dnsmasq
	option domainneeded '1'
	option boguspriv '1'
	option filterwin2k '0'
	option localise_queries '1'
	option rebind_protection '1'
	option rebind_localhost '1'
	option local '/lan/'
	option domain 'lan'
	option expandhosts '1'
	option nonegcache '0'
	option cachesize '1000'
	option authoritative '1'
	option readethers '1'
	option leasefile '/tmp/dhcp.leases'
	option noresolv '1'
	list server '127.0.0.1#1053'
	option nonwildcard '1'
	option localservice '1'
	option ednspacket_max '1232'
	option filter_aaaa '0'
	option filter_a '0'
	# mon.drasa.eu (the name on the TLS certificate) resolves to the router
	# itself. address_as_local makes it authoritative, so IPv4 lookups get an
	# empty answer rather than being forwarded upstream.
	# ban is the access point in the other room; it has a static ULA, so the
	# name does not depend on a lease or on the delegated prefix. It gets both
	# the LAN-style name and a drasa.eu name, the latter only for reading.
	# bead is a Raspberry Pi; llm.drasa.eu is its LLM vhost.
	option address_as_local '1'
	list address '/mon.drasa.eu/@ULA@::1'
	list address '/mon.lan/@ULA@::1'
	list address '/ban.lan/@ULA@::2'
	list address '/ban.drasa.eu/@ULA@::2'
	list address '/bead.lan/@ULA@::bead'
	list address '/bead.drasa.eu/@ULA@::bead'
	list address '/llm.drasa.eu/@ULA@::bead'

# cafe (the server) gets a static DHCPv6 lease: odhcpd matches this DUID and
# composes cafe's host id onto the LAN prefix, so the GUA is <LAN /64>::cafe and
# the ULA @ULA@::cafe. The AAAA records in /etc/config/ddns publish the GUA.
# Without the host id odhcpd hands out an address hashed from the DUID (::c04
# today), which is stable but meaningless to read.
config host
	option name 'cafe'
	option duid '0001000130d93a1e082e5f1bc5f0'
	option hostid 'cafe'

# bead gets the same treatment: its host id is spelled out so the address
# survives both the delegation churn and a DUID change.
config host
	option name 'bead'
	option duid '00010001c792bc8adca63208dbfe'
	option hostid 'bead'

config dhcp 'lan'
	option interface 'lan'
	option dhcpv4 'disabled'
	option ra 'server'
	option dhcpv6 'server'
	option ra_slaac '1'
	# Deliberately no ra_default: advertising a default route while there is no
	# upstream makes a client that is also attached to another network prefer
	# this router and lose connectivity. The cost is that, until the WAN is up,
	# odhcpd advertises router lifetime 0, so Apple clients (which ignore the
	# RA's RDNSS) get no DNS and reach the panel by IP rather than by name.
	list ra_flags 'managed-config'
	list ra_flags 'other-config'
	# Advertise the NAT64 prefix (RFC 8781) so a host that needs real IPv4 -
	# an app using an IPv4 literal or its own resolver - can build a CLAT and
	# translate for itself (464XLAT):
	option ra_pref64 '64:ff9b::/96'

config dhcp 'wan'
	option interface 'wan'
	option ignore '1'

# DHCPv4 for the jail. No `ra` and no `dhcpv6` options, so odhcpd leaves br-iot
# alone; the bridge carries no IPv6 address to advertise anyway.
config dhcp 'iot'
	option interface 'iot'
	option start '100'
	option limit '50'
	option leasetime '12h'

config odhcpd 'odhcpd'
	option maindhcp '0'
	option leasefile '/tmp/hosts/odhcpd'
	option leasetrigger '/usr/sbin/odhcpd-update'
	option loglevel '4'
