# The LAN is IPv6-only: no IPv4 leases, and addressing comes from odhcpd
# (RA/SLAAC for everyone, DHCPv6 for the static host ids below).
#
# dnsmasq is still the LAN resolver and owns the `lan` domain, but forwards
# everything to unbound on loopback, which synthesises AAAA records for
# IPv4-only names (DNS64). See /etc/config/unbound.

config dnsmasq
	option domainneeded '1'
	option boguspriv '1'
	option filterwin2k '0'
	option localise_queries '1'
	option rebind_protection '1'
	option rebind_localhost '1'
	option local '/lan/'
	option domain 'lan'
	option expandhosts '1'
	option nonegcache '0'
	option cachesize '1000'
	option authoritative '1'
	option readethers '1'
	option leasefile '/tmp/dhcp.leases'
	option noresolv '1'
	list server '127.0.0.1#1053'
	option nonwildcard '1'
	option localservice '1'
	option ednspacket_max '1232'
	option filter_aaaa '0'
	option filter_a '0'
	# mon.drasa.eu, the name on the TLS certificate, has to resolve to the
	# router itself. address_as_local makes these answers authoritative, so an
	# IPv4 lookup returns an empty answer instead of going upstream.
	# ban has a static ULA, so its names follow neither a lease nor the
	# delegated prefix. llm.drasa.eu is bead's LLM vhost.
	option address_as_local '1'
	list address '/mon.drasa.eu/@ULA@::1'
	list address '/mon.lan/@ULA@::1'
	list address '/ban.lan/@ULA@::2'
	list address '/ban.drasa.eu/@ULA@::2'
	list address '/bead.lan/@ULA@::bead'
	list address '/bead.drasa.eu/@ULA@::bead'
	list address '/llm.drasa.eu/@ULA@::bead'

# cafe and bead get their host id spelled out: odhcpd composes <LAN /64>::cafe
# and @ULA@::cafe instead of an address hashed from the DUID, and the address
# outlives a DUID change. /etc/config/ddns publishes the GUA.
config host
	option name 'cafe'
	option duid '00030001082e5f1bc5f0'
	option hostid 'cafe'

config host
	option name 'bead'
	option duid '00030001dca63208dbfc'
	option hostid 'bead'

# Fixed jail addresses, so dnsmasq serves them as <name>.lan and DHCP does not
# shuffle them. The iPad is deliberately absent: iOS rotates its private
# address, so a lease keyed on it would rot.
config host
	option name 'switch2'
	option mac 'b8:68:70:7c:e7:6c'
	option ip '10.10.1.101'

config host
	option name 'switch1'
	option mac 'a4:38:cc:2c:e5:fb'
	option ip '10.10.1.120'

config host
	option name 'doorbell'
	option mac '20:4e:f6:3a:2b:49'
	option ip '10.10.1.130'

config host
	option name 'aircon'
	option mac '28:c1:3c:78:4b:54'
	option ip '10.10.1.131'

config host
	option name 'scale'
	option mac '00:24:e4:1b:68:ac'
	option ip '10.10.1.133'

config dhcp 'lan'
	option interface 'lan'
	option dhcpv4 'disabled'
	option ra 'server'
	option dhcpv6 'server'
	option ra_slaac '1'
	# Deliberately no ra_default: advertising a default route while there is no
	# upstream makes a client that is also attached to another network prefer
	# this router and lose connectivity. The cost is that, until the WAN is up,
	# odhcpd advertises router lifetime 0, so Apple clients (which ignore the
	# RA's RDNSS) get no DNS and reach the panel by IP rather than by name.
	list ra_flags 'managed-config'
	list ra_flags 'other-config'
	# Advertise the NAT64 prefix (RFC 8781) so a host that needs real IPv4 -
	# an app using an IPv4 literal or its own resolver - can build a CLAT and
	# translate for itself (464XLAT):
	option ra_pref64 '64:ff9b::/96'

config dhcp 'wan'
	option interface 'wan'
	option ignore '1'

# DHCPv4 for the jail. No `ra` and no `dhcpv6` options, so odhcpd leaves br-iot
# alone; the bridge carries no IPv6 address to advertise anyway.
config dhcp 'iot'
	option interface 'iot'
	option start '100'
	option limit '50'
	option leasetime '12h'

config odhcpd 'odhcpd'
	option maindhcp '0'
	option leasefile '/tmp/hosts/odhcpd'
	option leasetrigger '/usr/sbin/odhcpd-update'
	option loglevel '4'
