# Dynamic DNS (Gandi LiveDNS) for the names published from the LAN.
#
# Public web hosts on the LAN get an A record for the WAN IPv4 (inbound IPv4
# terminates on the router) and an AAAA for the host's own GUA.
# Other hosts get an AAAA only.
#
# IP addresses are determined by two methods:
# Option `ip_source network` follows WAN IP changes automatically;
# option `ip_source script` calculates the LAN host's GUA IPv6 address using
# the delegated prefix and the `hostid`.
#
# The DNS updater script is overridden by the image because
# OpenWrt's packaged ddns-scripts sends Gandi's deprecated `Apikey` header,
# which the API rejects for personal access tokens.
#
# ddns-scripts cannot create a missing record, it only updates them:
# a failed lookup aborts the update and retries forever.
# So every A and AAAA rrset it updates must already exist in the zone.

config ddns 'global'
	option ddns_dateformat '%F %R'
	option ddns_loglines '250'
	option upd_privateip '0'

# --- A records (WAN IPv4) ---

config service 'bitwarden_a'
	option enabled '1'
	option service_name 'gandi.net'
	option lookup_host 'bitwarden.drasa.eu'
	option domain 'drasa.eu'
	option username 'bitwarden'
	option password '@GANDI_API_KEY@'
	option use_ipv6 '0'
	option ip_source 'network'
	option ip_network 'wan'
	option use_syslog '2'

config service 'syncthing_a'
	option enabled '1'
	option service_name 'gandi.net'
	option lookup_host 'syncthing.drasa.eu'
	option domain 'drasa.eu'
	option username 'syncthing'
	option password '@GANDI_API_KEY@'
	option use_ipv6 '0'
	option ip_source 'network'
	option ip_network 'wan'
	option use_syslog '2'

config service 'share_a'
	option enabled '1'
	option service_name 'gandi.net'
	option lookup_host 'share.drasa.eu'
	option domain 'drasa.eu'
	option username 'share'
	option password '@GANDI_API_KEY@'
	option use_ipv6 '0'
	option ip_source 'network'
	option ip_network 'wan'
	option use_syslog '2'

# --- AAAA records (cafe's GUA, suffix ::cafe) ---

config service 'bitwarden_aaaa'
	option enabled '1'
	option service_name 'gandi.net'
	option lookup_host 'bitwarden.drasa.eu'
	option domain 'drasa.eu'
	option username 'bitwarden'
	option password '@GANDI_API_KEY@'
	option use_ipv6 '1'
	option ip_source 'script'
	option ip_script '/usr/lib/ddns/lan_suffix.sh cafe'
