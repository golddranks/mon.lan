# Dynamic DNS (Gandi LiveDNS) for the names published from the LAN.
#
# Names served by cafe get an A record for the WAN IPv4 (inbound IPv4 terminates
# on the router's nginx stream proxy) and an AAAA for cafe's GUA. Hosts with a
# static DHCPv6 lease get an AAAA only. odhcpd takes the host id from that lease
# (`duid` plus `hostid`, see /etc/config/dhcp), so the AAAA is the current LAN
# /64 plus the host id; /usr/lib/ddns/lan_suffix.sh prints it.
#
# `ip_source network` follows DHCP/PD changes; the AAAA script follows the
# delegated prefix. The provider script in /usr/lib/ddns is overridden by the
# image because the packaged ddns-scripts sends Gandi's retired `Apikey`
# header, which the API rejects for personal access tokens.
#
# ddns-scripts cannot create a missing record: a failed lookup aborts the update
# and retries forever. Each name must already have an A and an AAAA rrset in the
# zone; this config only updates them. If a record is deleted, create it once
# (and expect the zone's negative TTL to delay recovery in the local caches).

config ddns 'global'
	option ddns_dateformat '%F %R'
	option ddns_loglines '250'
	option upd_privateip '0'

# --- A records (WAN IPv4) ---

config service 'bitwarden_a'
	option enabled '1'
	option service_name 'gandi.net'
	option lookup_host 'bitwarden.drasa.eu'
	option domain 'drasa.eu'
	option username 'bitwarden'
	option password '@GANDI_API_KEY@'
	option use_ipv6 '0'
	option ip_source 'network'
	option ip_network 'wan'
	option use_syslog '2'

config service 'syncthing_a'
	option enabled '1'
	option service_name 'gandi.net'
	option lookup_host 'syncthing.drasa.eu'
	option domain 'drasa.eu'
	option username 'syncthing'
	option password '@GANDI_API_KEY@'
	option use_ipv6 '0'
	option ip_source 'network'
	option ip_network 'wan'
	option use_syslog '2'

config service 'webshare_a'
	option enabled '1'
	option service_name 'gandi.net'
	option lookup_host 'webshare.drasa.eu'
	option domain 'drasa.eu'
	option username 'webshare'
	option password '@GANDI_API_KEY@'
	option use_ipv6 '0'
	option ip_source 'network'
	option ip_network 'wan'
	option use_syslog '2'

# --- AAAA records (cafe's GUA, suffix ::cafe) ---

config service 'bitwarden_aaaa'
	option enabled '1'
	option service_name 'gandi.net'
	option lookup_host 'bitwarden.drasa.eu'
	option domain 'drasa.eu'
	option username 'bitwarden'
	option password '@GANDI_API_KEY@'
	option use_ipv6 '1'
	option ip_source 'script'
	option ip_script '/usr/lib/ddns/lan_suffix.sh cafe'
	option use_syslog '2'

config service 'syncthing_aaaa'
	option enabled '1'
	option service_name 'gandi.net'
	option lookup_host 'syncthing.drasa.eu'
	option domain 'drasa.eu'
	option username 'syncthing'
	option password '@GANDI_API_KEY@'
	option use_ipv6 '1'
	option ip_source 'script'
	option ip_script '/usr/lib/ddns/lan_suffix.sh cafe'
	option use_syslog '2'

config service 'webshare_aaaa'
	option enabled '1'
	option service_name 'gandi.net'
	option lookup_host 'webshare.drasa.eu'
	option domain 'drasa.eu'
	option username 'webshare'
	option password '@GANDI_API_KEY@'
	option use_ipv6 '1'
	option ip_source 'script'
	option ip_script '/usr/lib/ddns/lan_suffix.sh cafe'
	option use_syslog '2'

config service 'cafe_a'
	option enabled '1'
	option service_name 'gandi.net'
	option lookup_host 'cafe.drasa.eu'
	option domain 'drasa.eu'
	option username 'cafe'
	option password '@GANDI_API_KEY@'
	option use_ipv6 '0'
	option ip_source 'network'
	option ip_network 'wan'
	option use_syslog '2'

config service 'cafe_aaaa'
	option enabled '1'
	option service_name 'gandi.net'
	option lookup_host 'cafe.drasa.eu'
	option domain 'drasa.eu'
	option username 'cafe'
	option password '@GANDI_API_KEY@'
	option use_ipv6 '1'
	option ip_source 'script'
	option ip_script '/usr/lib/ddns/lan_suffix.sh cafe'
	option use_syslog '2'

# bead has no A record: it is reachable only over IPv6, which is what its
# certificate and its :80 ACME challenge are validated over.
config service 'bead_aaaa'
	option enabled '1'
	option service_name 'gandi.net'
	option lookup_host 'bead.drasa.eu'
	option domain 'drasa.eu'
	option username 'bead'
	option password '@GANDI_API_KEY@'
	option use_ipv6 '1'
	option ip_source 'script'
	option ip_script '/usr/lib/ddns/lan_suffix.sh bead'
	option use_syslog '2'

# The LLM has its own name on the same host, with its own certificate.
config service 'llm_aaaa'
	option enabled '1'
	option service_name 'gandi.net'
	option lookup_host 'llm.drasa.eu'
	option domain 'drasa.eu'
	option username 'llm'
	option password '@GANDI_API_KEY@'
	option use_ipv6 '1'
	option ip_source 'script'
	option ip_script '/usr/lib/ddns/lan_suffix.sh bead'
	option use_syslog '2'
