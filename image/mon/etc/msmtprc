# SMTP server and credentials for mon-send; 0600 in the image. The password is
# substituted from secrets.sed at build time. Give the relay an account that can
# do nothing but send, and a From the relay accepts for it.
#
# The port and the TLS mode must agree: 465 encrypts from the first byte
# (tls_starttls off), while 587, 25 and 2525 take the greeting in the clear and
# upgrade afterwards (tls_starttls on). Keep the values bare, because msmtp does
# not strip single quotes and would send them as part of the user or password.
# The logfile lives in /tmp, so nothing here survives a reboot.
defaults
auth on
tls on
tls_trust_file /etc/ssl/certs/ca-certificates.crt
logfile /tmp/msmtp.log

account default
host smtp.eu.mailgun.org
port 465
tls_starttls off
user ghost@drasa.eu
password @SMTP_PASSWORD@
from ghost@drasa.eu
