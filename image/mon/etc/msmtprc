# Server and credentials for mon-send; 0600 in the image.
#
# Gmail requires 2-Step Verification and an App Password (Google Account ->
# Security -> App passwords). Gmail rewrites From to the authenticated account
# unless the address is a verified alias (Settings -> Accounts -> Send mail as).
#
# Keep the values bare. msmtp does not strip single quotes from these, so a
# quoted user/password is sent with the quotes and Google answers 535. The app
# password's four groups of four are displayed with spaces; the spaces are not
# part of it. The logfile is in /tmp, so nothing here survives a reboot.
defaults
auth on
tls on
tls_trust_file /etc/ssl/certs/ca-certificates.crt
logfile /tmp/msmtp.log

account default
host smtp.gmail.com
port 465
tls_starttls off
user admin@drasa.eu
password @SMTP_PASSWORD@
from ghost@drasa.eu
