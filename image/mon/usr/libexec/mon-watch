#!/bin/sh
# Mail when the set of failing checkup checks, or an observed value, changes.
#
# `[value]` lines from checkup are remembered in /root/mon-watch.values. They
# are observations, not checks: a renumbering that stays healthy produces no
# failure at all, so the values are what make it visible.
set -u

CHECKUP=/usr/bin/checkup
SEND=/usr/libexec/mon-send
FAILURES=/root/mon-watch.failures
VALUES=/root/mon-watch.values
# How long to wait before looking again at a failure that was not there last
# time. Five minutes outlives a reboot window or a service restart; the second
# look is what decides whether the mail is sent.
CONFIRM_SECONDS=300

# One run at a time. A run outlasts the ten minutes between cron firings - the
# second look alone sleeps five - so a second one would decide against a state
# the first has not written yet, and mail the same failures again.
exec 9>/tmp/mon-watch.lock
flock -n 9 || exit 0

prev=""
[ -f "$FAILURES" ] && prev=$(cat "$FAILURES")
values_seen=0
[ -f "$VALUES" ] && values_seen=1

# Every message says how old the boot is: a failure reported a minute after a
# reboot is usually that, and the uptime makes it obvious.
stamp() {
	up=$(cut -d. -f1 /proc/uptime)
	printf 'mon, %s (uptime %sh%02dm)\n' "$(date +%FT%T%z)" \
		"$((up / 3600))" "$((up % 3600 / 60))"
}

if [ ! -x "$CHECKUP" ]; then
	# One message, not one per cron run: the state file records this too.
	[ "$prev" = "checkup-missing" ] && exit 0
	body=/tmp/mon-watch.$$
	{
		stamp
		printf '\ncheckup is not executable at %s\n' "$CHECKUP"
	} > "$body"
	printf '%s\n' "checkup-missing" > "$FAILURES"
	$SEND "checkup missing" "$body" 9>&-
	rm -f "$body"
	exit 1
fi

# checkup prints "[FAIL] %-20s %s", and the state file records only the label, so
# this recovers the whole line - the reason is what makes it readable.
fail_line() {
	printf '%s\n' "$out" | grep -F "[FAIL] $(printf '%-20s' "$1")" || true
}

# Extracts the failing labels into $now and the observed values into $now_vals.
# checkup prints "[FAIL] %-20s %s", so a label is the first 20 columns; checkup
# keeps every label within those, and a longer one would be cut here and could
# never match the line fail_line() looks up.
collect() {
	now=$(printf '%s\n' "$out" |
		sed -n 's/^\[FAIL\] //p' |
		cut -c1-20 |
		sed 's/ *$//' |
		sort -u)

	# `[info]` lines whose label matches a value annotate that value in the mail,
	# so a value can stay one word and still show what it is about.
	now_notes=$(printf '%s\n' "$out" | awk '
		/^\[info\] / {
			label = substr($0, 8, 20)
			sub(/ +$/, "", label)
			note = substr($0, 28)
			sub(/^ +/, "", note)
			print label "=" note
		}')

	# The same 20-column layout, so a value's label is comparable too.
	now_vals=$(printf '%s\n' "$out" | awk '
		/^\[value\] / {
			label = substr($0, 9, 20)
			sub(/ +$/, "", label)
			val = substr($0, 29)
			sub(/^ +/, "", val)
			print label "=" val
		}' | sort)
}

# Labels failing now that were not failing in the previous run.
appeared() {
	printf '%s\n' "$now" | while IFS= read -r l; do
		[ -n "$l" ] || continue
		printf '%s\n' "$prev" | grep -qxF "$l" || printf '%s\n' "$l"
	done
}

# The lock's descriptor is closed around the children: one that lingers would
# keep the lock and silence every later run.
out=$($CHECKUP 2>&1 9>&-)
collect

# Nothing is mailed on a first sighting: a reboot window, a service restart or a
# flapping link is over by the time a second run looks, and a real failure is
# not. One extra run, and only when something new showed up.
if [ -n "$(appeared)" ]; then
	sleep "$CONFIRM_SECONDS"
	out=$($CHECKUP 2>&1 9>&-)
	collect
fi

# Report a changed value, an appearing one, or a disappearing one. Skipped on
# the first run (no file yet) and when checkup printed no values at all: an
# older or broken checkup must not look like every value vanished.
changed_vals=
if [ "$values_seen" -eq 1 ] && [ -n "$now_vals" ]; then
	changed_vals=$(printf '%s\n' "$now_vals" | awk -v file="$VALUES" '
		BEGIN {
			while ((getline line < file) > 0) {
				eq = index(line, "=")
				if (eq) old[substr(line, 1, eq - 1)] = substr(line, eq + 1)
			}
			close(file)
		}
		{
			if ($0 == "") next
			eq = index($0, "=")
			label = substr($0, 1, eq - 1)
			val = substr($0, eq + 1)
			seen[label] = 1
			if (label in old) {
				if (old[label] != val)
					print label ": " old[label] " -> " val
			} else {
				print label ": " val " (new)"
			}
		}
		END {
			for (l in old)
				if (!(l in seen))
					print l ": " old[l] " (gone)"
		}' | sort)
fi

fail_changed=0
[ "$now" = "$prev" ] || fail_changed=1
value_changed=0
[ -n "$changed_vals" ] && value_changed=1

[ "$fail_changed" -eq 0 ] && [ "$value_changed" -eq 0 ] && {
	# Still record, or the first run would never seed the files.
	printf '%s\n' "$now" > "$FAILURES"
	[ -n "$now_vals" ] && printf '%s\n' "$now_vals" > "$VALUES"
		exit 0
}

added=$(appeared)
cleared=$(printf '%s\n' "$prev" | while IFS= read -r l; do
	[ -n "$l" ] || continue
	printf '%s\n' "$now" | grep -qxF "$l" || printf '%s\n' "$l"
done)
added_n=$(printf '%s\n' "$added" | grep -c .)
cleared_n=$(printf '%s\n' "$cleared" | grep -c .)

# The subject says what changed and how much; the lines themselves are in the
# body, and repeating them here only makes the subject unreadable.
if [ "$fail_changed" -eq 1 ] && [ -z "$now" ]; then
	event="no failures"
elif [ "$fail_changed" -eq 1 ] && [ "$added_n" -gt 0 ]; then
	if [ "$added_n" -eq 1 ]; then
		event="1 new failure"
	else
		event="$added_n new failures"
	fi
elif [ "$fail_changed" -eq 1 ] && [ "$cleared_n" -gt 0 ]; then
	event="$cleared_n fixed"
elif [ "$fail_changed" -eq 1 ]; then
	event="failures changed"
else
	event="values changed"
fi

body=/tmp/mon-watch.$$
{
	if [ -n "$added" ]; then
		printf 'new failures:\n'
		printf '%s\n' "$added" | while IFS= read -r l; do
			[ -n "$l" ] || continue
			fail_line "$l" | sed 's/^/  /'
		done
		printf '\n'
	fi
	if [ -n "$cleared" ]; then
		printf 'cleared:\n'
		printf '%s\n' "$cleared" | sed 's/^/  [FIXED] /'
		printf '\n'
	fi
	if [ -n "$changed_vals" ]; then
		printf 'values changed:\n'
		printf '%s\n' "$changed_vals" | while IFS= read -r line; do
			[ -n "$line" ] || continue
			printf '  %s\n' "$line"
			printf '%s\n' "$now_notes" | grep -F "${line%%:*}=" | cut -d= -f2- | sed 's/^/    /'
		done
		printf '\n'
	fi
	if [ -z "$now" ]; then
		printf 'no failures\n'
	else
		printf 'current failures:\n'
		printf '%s\n' "$now" | while IFS= read -r l; do
			[ -n "$l" ] || continue
			fail_line "$l" | sed 's/^/  /'
		done
	fi
	# The body ends on a plain line: a trailing indented block reads as quoted
	# text to Gmail, which then hides it behind a "..." button.
	printf '\n'
	stamp
} > "$body"

# Recorded before the send: msmtp can spend two minutes on the wire, and the
# state has to be current by the time the next cron run looks.
printf '%s\n' "$now" > "$FAILURES"
[ -n "$now_vals" ] && printf '%s\n' "$now_vals" > "$VALUES"

$SEND "$event" "$body" 9>&-
rm -f "$body"

exit 0
