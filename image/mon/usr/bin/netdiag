#!/bin/sh
# Regression checks for the invariants this repo's mon configuration is built
# around.
#
# Expectations are hard-coded below. Deployment values - the ULA prefix from
# uci, the LAN prefix from netifd's prefix assignment - are read at run time,
# because they are operator and ISP data, not invariants. If the design changes,
# this file has to change with it, and a stale copy here will report FAIL with
# confidence.
#
# `[value]` lines are observations, not checks: mon-watch remembers them and
# mails when one changes, so a renumbering that stays healthy is still visible.
#
# Not covered: ACME renewal itself (only the certificate it produced is
# checked), cafe's own services beyond a TCP handshake, and the NAT64 datapath
# when ban is offline (the datapath check needs a host on the LAN).
#
# Read-only. Exit status is 1 if any check fails.

WAN_DEV="eth1"
LAN_DEV="br-lan"
MON_NAME="mon.drasa.eu"
WEB_NAME="webshare.drasa.eu"
ula_stem=$(uci -q get network.globals.ula_prefix | sed 's|::/[0-9]*$||')
ULA="$ula_stem::1"
BAN_ULA="$ula_stem::2"
CAFE_ULA="$ula_stem::cafe"
BEAD_ULA="$ula_stem::bead"
POOL6="64:ff9b::/96"
PREFIX_STEM="64:ff9b::"
JOOL_INSTANCE="nat64"
CERT_MIN_DAYS=14
PROBE_KEY="/root/.ssh/id_ed25519"

bad=0

# Labels are padded to 20 columns because mon-watch parses them at that width to
# tell which checks are failing, and `[value]` lines at the same width to tell
# which value changed. Keep every label at 20 characters or fewer.
pass() { printf '[PASS] %-20s %s\n' "$1" "$2"; }
fail() {
	printf '[FAIL] %-20s %s\n' "$1" "$2"
	bad=1
}
info() { printf '[info] %-20s %s\n' "$1" "$2"; }
skip() { printf '[skip] %-20s %s\n' "$1" "$2"; }
value() { printf '[value] %-20s %s\n' "$1" "$2"; }
group() { printf '\n== %s ==\n' "$1"; }

[ -n "$ula_stem" ] ||
	fail "ula prefix" "network.globals.ula_prefix is unset; ULA checks are meaningless"

# Answers for a name, one per line; the resolver's own "Address: x:53" dropped.
# $3 is an optional query type (A, AAAA).
dns_answers() {
	if [ -n "${3-}" ]; then
		nslookup -type="$3" "$2" "$1" 2>/dev/null |
			sed -n 's/^Address:[[:space:]]*//p' | grep -vxF "$1:53"
	else
		nslookup "$2" "$1" 2>/dev/null |
			sed -n 's/^Address:[[:space:]]*//p' | grep -vxF "$1:53"
	fi
}

http_code() { curl -s -o /dev/null -w '%{http_code}' --max-time 8 "$@" 2>/dev/null; }

on_ban() {
	ssh -T -i "$PROBE_KEY" "root@$BAN_ULA" "$1" 2>/dev/null </dev/null
}

# --- identity ---------------------------------------------------------------
group identity
release=$(sed -n "s/^DISTRIB_DESCRIPTION='\(.*\)'/\1/p" /etc/openwrt_release)
info "image" "${release:-unknown}"

wan4=$(ubus call network.interface.wan status 2>/dev/null |
	jsonfilter -e '@["ipv4-address"][0].address' 2>/dev/null | head -n 1)
wan6_addr=$(ubus call network.interface.wan6 status 2>/dev/null |
	jsonfilter -e '@["ipv6-address"][0].address' 2>/dev/null | head -n 1)

# --- WAN and delegation -----------------------------------------------------
group wan
wan6_status=$(ubus call network.interface.wan6 status 2>/dev/null)
pd_addr=$(printf '%s' "$wan6_status" |
	jsonfilter -e '@["ipv6-prefix"][0].address' 2>/dev/null)
pd_mask=$(printf '%s' "$wan6_status" |
	jsonfilter -e '@["ipv6-prefix"][0].mask' 2>/dev/null)

if [ -n "$wan4" ]; then
	pass "wan ipv4" "$wan4"
else
	fail "wan ipv4" "no global address on $WAN_DEV"
fi

if [ -n "$pd_addr" ]; then
	pass "delegated prefix" "$pd_addr/$pd_mask"
else
	fail "delegated prefix" "wan6 has no ipv6-prefix"
fi
value "pd" "${pd_addr:-none}/${pd_mask:-0}"

if [ "$pd_mask" = "56" ]; then
	pass "prefix length" "/56 as requested"
else
	fail "prefix length" "expected 56, got '${pd_mask:-none}'"
fi

# --- LAN addressing ---------------------------------------------------------
group lan
lan6=$(ip -6 -o addr show dev "$LAN_DEV" scope global 2>/dev/null |
	sed -n 's/.* inet6 \([0-9a-fA-F:]*\)\/.*/\1/p')
lan6_list=$(printf '%s' "$lan6" | tr '\n' ' ')

if [ -n "$(ip -4 -o addr show dev "$LAN_DEV" 2>/dev/null)" ]; then
	fail "lan ipv4" "$LAN_DEV has an IPv4 address; the LAN must be v6-only"
else
	pass "lan ipv4" "none on $LAN_DEV"
fi

case " $lan6_list " in
*" $ULA "*) pass "lan ula" "$ULA" ;;
*) fail "lan ula" "expected $ULA on $LAN_DEV, have: $lan6_list" ;;
esac

# The LAN /64 is whatever netifd took from the delegation, not a value written
# down in this repo. A static GUA survives a PD change and stays plausible while
# the ISP routes nothing, so the address on br-lan is checked against the
# assignment. The ULA is an assignment too: skip it, or the check compares the
# LAN GUA against the ULA.
if [ -n "$ula_stem" ]; then
	lan_pd=$(ubus call network.interface.lan status 2>/dev/null |
		jsonfilter -e '@["ipv6-prefix-assignment"][*].address' 2>/dev/null |
		grep -v "^${ula_stem}" | head -n 1)
fi
lan_pd_stem=$(printf '%s' "$lan_pd" | sed 's/:*$//')

lan_gua=
for a in $lan6; do
	case "$a" in
	"$ula_stem"*) continue ;;
	esac
	if [ -n "$lan_pd_stem" ] &&
		[ "$(printf '%s' "$a" | cut -d: -f1-4)" = "$lan_pd_stem" ]; then
		lan_gua=$a
		break
	fi
done

if [ -z "$lan_pd_stem" ]; then
	fail "lan prefix" "netifd assigned no prefix from the delegation to $LAN_DEV"
elif [ -z "$lan_gua" ]; then
	fail "lan gua" "no address inside $lan_pd/64 on $LAN_DEV; have: $lan6_list"
else
	pass "lan gua" "$lan_gua from $lan_pd/64"
fi
value "lan gua" "${lan_gua:-none}"

# Clients get their addresses from the prefix odhcpd advertises, so a bound
# lease inside the delegation is the consequence of the assignment actually
# reaching the LAN. A stale advertised prefix leaves every lease outside it.
lease_lines=$(ubus call dhcp ipv6leases 2>/dev/null |
	jsonfilter -e '@["device"]["br-lan"]["leases"][*]' 2>/dev/null)
lease_counts=$(printf '%s\n' "$lease_lines" | awk -v stem="$lan_pd_stem" '
	/"bound"/ {
		bound++
		if (stem != "" && index($0, stem ":") > 0) inpd++
	}
	END { print bound + 0, inpd + 0 }')
bound_leases=${lease_counts% *}
leases_in_pd=${lease_counts#* }
if [ "$bound_leases" -eq 0 ]; then
	fail "dhcpv6 leases" "no bound leases on $LAN_DEV"
elif [ -z "$lan_pd_stem" ] || [ "$leases_in_pd" -eq 0 ]; then
	fail "dhcpv6 leases" "none of $bound_leases bound lease(s) is inside ${lan_pd:-the LAN /64}"
else
	pass "dhcpv6 leases" "$leases_in_pd of $bound_leases bound lease(s) inside $lan_pd/64"
fi

probe6="2606:4700:4700::1111"

if [ -z "$lan_gua" ]; then
	skip "lan route" "no LAN GUA to route"
elif ip -6 route get "$probe6" from "$lan_gua" >/dev/null 2>&1; then
	pass "lan route" "$lan_gua"
else
	fail "lan route" "no default route matches source $lan_gua"
fi

# --- the prefix is actually routed upstream ---------------------------------
group upstream
# Holding a delegation means only that netifd has one. J:COM has stopped routing
# ours while the lease still looked valid for days, and every check above stayed
# green. Ping out sourced from the LAN GUA: same next hop, but the source is what
# an ISP filters on. The WAN-sourced probe is the control, so a dead uplink is
# reported as such instead of as a bad prefix. Three packets each: a working
# prefix has lost its first one in testing.
if [ -z "$lan_gua" ] || [ -z "$wan6_addr" ]; then
	skip "lan-sourced egress" "need both a LAN GUA and a WAN IPv6 address"
elif ! ping6 -c 3 -W 2 -I "$wan6_addr" "$probe6" >/dev/null 2>&1; then
	fail "lan-sourced egress" "no uplink at all: $wan6_addr cannot reach $probe6"
elif ping6 -c 3 -W 2 -I "$lan_gua" "$probe6" >/dev/null 2>&1; then
	pass "lan-sourced egress" "$lan_gua -> $probe6"
else
	fail "lan-sourced egress" "$lan_gua gets no reply while $wan6_addr does: the prefix is not routed upstream"
fi

# --- names ------------------------------------------------------------------
group names
dns64=$(nslookup ipv4only.arpa 127.0.0.1 2>/dev/null |
	grep -o "${PREFIX_STEM}[0-9a-fA-F:]*" | head -n 1)
if [ -n "$dns64" ]; then
	pass "dns64" "ipv4only.arpa -> $dns64"
else
	fail "dns64" "no synthesised AAAA from the local resolver"
fi

for pair in "$MON_NAME|$ULA" "ban.lan|$BAN_ULA" "ban.drasa.eu|$BAN_ULA" \
	"bead.lan|$BEAD_ULA" "bead.drasa.eu|$BEAD_ULA" \
	"llm.drasa.eu|$BEAD_ULA"; do
	name=${pair%|*}
	want=${pair#*|}
	answers=$(dns_answers 127.0.0.1 "$name")
	case "
$answers
" in
	*"
$want
"*) pass "name $name" "$want" ;;
	*) fail "name $name" "expected $want, got: $(printf '%s' "$answers" | tr '\n' ' ')" ;;
	esac
done

# --- hosts ------------------------------------------------------------------
group hosts
if ping6 -c 1 -W 1 "$BAN_ULA" >/dev/null 2>&1; then
	pass "ban reachable" "$BAN_ULA"
else
	fail "ban reachable" "no echo reply from $BAN_ULA"
fi

# The AP must not form a GUA: mon forwards 22/80/443 to the LAN zone, so any
# address on ban that is not the ULA would be reachable from the internet.
if [ ! -f "$PROBE_KEY" ]; then
	skip "ban no gua" "no probe key at $PROBE_KEY"
elif ! ping6 -c 1 -W 1 "$BAN_ULA" >/dev/null 2>&1; then
	skip "ban no gua" "ban is offline"
else
	ban_guas=$(on_ban 'ip -6 addr show dev br-lan' |
		sed -n 's/^ *inet6 \([0-9a-fA-F:]*\)\/.* scope global.*/\1/p' |
		grep -v "^${ula_stem}" | tr '\n' ' ')
	if [ -z "$ban_guas" ]; then
		pass "ban no gua" "only the ULA"
	else
		fail "ban no gua" "GUA(s) on br-lan: $ban_guas"
	fi
fi

if ping6 -c 1 -W 1 "$BEAD_ULA" >/dev/null 2>&1; then
	pass "bead reachable" "$BEAD_ULA"
else
	fail "bead reachable" "no echo reply from $BEAD_ULA"
fi

# usteer trades node and station state with the other AP over the LAN, over IPv6.
# One entry per peer; empty means the instances cannot see each other, which is
# what happens when `option ipv6` is left at its default of 0.
peers=$(ubus -t 5 call usteer remote_hosts 2>/dev/null | grep -c '"id":')
if [ "${peers:-0}" -gt 0 ]; then
	pass "usteer peers" "$peers peer(s)"
else
	fail "usteer peers" "none; the APs are not exchanging state"
fi

# --- NAT64 ------------------------------------------------------------------
group nat64
if jool instance display >/dev/null 2>&1; then
	pass "jool instance" "$JOOL_INSTANCE running"
else
	fail "jool instance" "no jool instance"
fi

# Jool only translates forwarded traffic, so mon cannot test its own translation:
# a ping from the router, or a connection to the router's own WAN address, never
# enters the forward hook. The probe therefore runs on ban, an ordinary host on
# the LAN whose packets are forwarded and translated like any client's.
#
# All three protocols are probed because pool4 holds a separate table per
# protocol: a missing row breaks that protocol alone, and the other two keep
# working.
if [ ! -f "$PROBE_KEY" ]; then
	skip "nat64 datapath" "no probe key at $PROBE_KEY"
elif ! ping6 -c 1 -W 1 "$BAN_ULA" >/dev/null 2>&1; then
	skip "nat64 datapath" "ban is offline; the probe needs a host on the LAN"
else
	if on_ban 'ping6 -c 1 -W 3 64:ff9b::808:808' >/dev/null 2>&1; then
		icmp=ok
	else
		icmp=no
	fi

	# A DNS query to 8.8.8.8 through NAT64 is the UDP path.
	if on_ban 'nslookup example.com 64:ff9b::808:808' | grep -q '^Name:'; then
		udp=ok
	else
		udp=no
	fi

	# busybox wget exits 8 when the server answers with an HTTP error, which is
	# still a completed TCP connection - that is all this probes.
	tcp_rc=$(on_ban 'wget -T 5 -O /dev/null "http://[64:ff9b::101:101]/" >/dev/null 2>&1; echo $?')
	case "$tcp_rc" in
	0 | 8) tcp=ok ;;
	*) tcp=no ;;
	esac

	if [ "$icmp$udp$tcp" = okokok ]; then
		pass "nat64 datapath" "icmp/udp/tcp from ban"
	else
		fail "nat64 datapath" "icmp=$icmp udp=$udp tcp=$tcp from ban"
	fi
fi

info "ephemeral ports" "$(sysctl -n net.ipv4.ip_local_port_range 2>/dev/null |
	tr -s ' \t' ' ')"
info "jool counters" "$(jool -i "$JOOL_INSTANCE" stats display 2>/dev/null |
	grep -E 'JSTAT_(BIB_ENTRIES|SESSIONS|POOL4_MISMATCH):' | tr '\n' ' ')"

# --- enforcement ------------------------------------------------------------
group enforcement
# IPv4-only bridge for devices that cannot use IPv6. It needs its own address,
# and must carry no global IPv6 address - one there would put jail devices on
# the LAN's addressing while sitting in another zone. Client isolation is a
# setting, so this is a lint, not a consequence.
jail4=$(ip -4 -o addr show dev br-iot 2>/dev/null | awk '{ print $4 }')
jail6=$(ip -6 -o addr show dev br-iot scope global 2>/dev/null |
	sed -n 's/.* inet6 \([^/]*\)\/.*/\1/p')
jail_iso=$(uci -q get wireless.jail_radio0.isolate)
if [ -z "$jail4" ]; then
	fail "jail" "br-iot has no IPv4 address"
elif [ -n "$jail6" ]; then
	fail "jail" "$jail6 is on br-iot; the jail must stay IPv4-only"
elif [ "$jail_iso" != "1" ]; then
	fail "jail" "client isolation is off; jail devices can reach each other"
else
	pass "jail" "lint - $jail4, isolated, no IPv6"
fi

# A lint until an external probe exists (a host outside the WAN trying 22/80/443
# is the real consequence). It reads the wan input chain, so it also catches a
# rule that opens the router itself.
input_wan=$(nft list chain inet fw4 input_wan 2>/dev/null)
input_open=$(printf '%s\n' "$input_wan" | awk '
	/comment/ { sub(/comment ".*/, "") }
	/nfproto ipv4/ { next }
	/accept/ && /tcp dport/ {
			sub(/.*tcp dport[ ]+/, "")
			sub(/[ ](counter|accept|jump|drop|reject|return).*/, "")
			gsub(/[{},]/, " ")
			print
	}' | tr ' ' '\n' | grep -xE '22|80|443' | sort -un | tr '\n' ' ')

if [ -n "$input_open" ]; then
	fail "fw v6 input" "accepted from WAN: $input_open"
elif [ -z "$input_wan" ]; then
	fail "fw v6 input" "cannot read the wan input chain"
else
	pass "fw v6 input" "lint - no 22/80/443 accepted from WAN"
fi

# --- services ---------------------------------------------------------------
group services
for svc in odhcpd dnsmasq unbound nginx uwsgi usteer; do
	if pgrep -f "$svc" >/dev/null 2>&1; then
		pass "service $svc" "running"
	else
		fail "service $svc" "not running"
	fi
done

# --- web and TLS ------------------------------------------------------------
group web
code=$(http_code -k "https://[$ULA]/")
if [ "$code" = "200" ]; then
	pass "luci https" "200 on [$ULA]"
else
	fail "luci https" "expected 200 on [$ULA], got '$code'"
fi

code=$(http_code "http://[$ULA]/")
if [ "$code" = "301" ]; then
	pass "http redirect" "301 to https"
else
	fail "http redirect" "expected 301 on [$ULA], got '$code'"
fi

code=$(http_code "https://$MON_NAME/")
if [ "$code" = "200" ]; then
	pass "tls verified" "$MON_NAME validates against the CA bundle"
else
	fail "tls verified" "expected 200 with a valid cert, got '$code'"
fi

if openssl s_client -connect "[$ULA]:443" -servername "$MON_NAME" </dev/null 2>/dev/null |
	openssl x509 -checkend "$((CERT_MIN_DAYS * 86400))" -noout >/dev/null 2>&1; then
	pass "cert expiry" "valid for more than $CERT_MIN_DAYS days"
else
	fail "cert expiry" "certificate expires within $CERT_MIN_DAYS days"
fi

code=$(http_code -k "https://[$CAFE_ULA]/")
if [ "$code" != "000" ] && [ -n "$code" ]; then
	pass "cafe 443" "$code from [$CAFE_ULA]"
else
	fail "cafe 443" "no answer from [$CAFE_ULA]"
fi

if [ -n "$wan4" ]; then
	code=$(http_code -k --resolve "$WEB_NAME:443:$wan4" "https://$WEB_NAME/")
	if [ "$code" = "200" ]; then
		pass "v4 web path" "$WEB_NAME via $wan4:443 -> cafe"
	else
		fail "v4 web path" "expected 200 via $wan4:443, got '$code'"
	fi
else
	skip "v4 web path" "no WAN IPv4"
fi

# --- wireless and NTP -------------------------------------------------------
group wireless
radios_up=$(ubus call network.wireless status 2>/dev/null |
	jsonfilter -e '@.*.up' | grep -c true)
if [ "$radios_up" = "2" ]; then
	pass "wireless" "2 radios up"
else
	fail "wireless" "$radios_up radios up, expected 2"
fi

want_ssid=$(uci -q get wireless.@wifi-iface[0].ssid)
jail_ssid=$(uci -q get wireless.jail_radio0.ssid)
wifi_status=$(ubus call network.wireless status 2>/dev/null)
main_on=$(printf '%s' "$wifi_status" |
	jsonfilter -e '@.*.interfaces[*].config.ssid' | grep -cxF "$want_ssid")
jail_on=$(printf '%s' "$wifi_status" |
	jsonfilter -e '@.*.interfaces[*].config.ssid' | grep -cxF "$jail_ssid")
jail_on_24=$(printf '%s' "$wifi_status" |
	jsonfilter -e '@.radio0.interfaces[*].config.ssid' | grep -cxF "$jail_ssid")
# The main SSID on both radios; the jail on 2.4 GHz only, which is what keeps
# it out of the 5 GHz airtime and out of ban, whose uplink cannot carry it.
if [ "$main_on" = "2" ] && [ "$jail_on" = "1" ] && [ "$jail_on_24" = "1" ]; then
	pass "ssid" "$want_ssid x2, $jail_ssid on radio0"
else
	fail "ssid" "$want_ssid on $main_on radio(s), $jail_ssid on $jail_on ($jail_on_24 on radio0)"
fi

# Whether ntpd answers is the consequence; enable_server is only the setting.
if netstat -lnup 2>/dev/null | awk '$4 ~ /:123$/ { found = 1 } END { exit !found }'; then
	pass "ntp server" "123/udp is bound"
else
	fail "ntp server" "nothing is listening on 123/udp"
fi

# --- published DNS ----------------------------------------------------------
group dns
# Recursive resolvers keep serving the old rrset for up to the zone TTL after a
# renumber, so ask the zone's own nameservers instead: they always have the
# current data.
ddns_domain=$(uci -q get ddns.cafe_a.domain)
ddns_resolver=1.1.1.1
if [ -n "$ddns_domain" ]; then
	ns=$(nslookup -type=NS "$ddns_domain" 1.1.1.1 2>/dev/null |
		sed -n 's/.*nameserver = //p' | head -n 1)
	if [ -n "$ns" ]; then
		ns_addr=$(dns_answers 1.1.1.1 "$ns" A | head -n 1)
		[ -n "$ns_addr" ] && ddns_resolver=$ns_addr && ddns_ns=$ns
	fi
fi
info "ddns resolver" "$ddns_resolver${ddns_ns:+ ($ddns_ns, authoritative)}"

for section in $(uci -q show ddns |
	sed -n 's/^ddns\.\([^.=]*\)\.lookup_host=.*/\1/p'); do
	host=$(uci -q get "ddns.$section.lookup_host")
	if [ "$(uci -q get "ddns.$section.use_ipv6")" = "1" ]; then
		# The AAAA is the LAN /64 plus the host id given to the section's
		# ip_script (`lan_suffix.sh bead` publishes ::bead).
		suffix=$(uci -q get "ddns.$section.ip_script" | awk '{ print $NF }')
		expected=
		[ -n "$suffix" ] &&
			expected="$(printf '%s' "${lan_gua:-}" | cut -d: -f1-4)::$suffix"
		qtype=AAAA
	else
		suffix=
		expected="$wan4"
		qtype=A
	fi

	case "$expected" in
	'' | ::*)
		skip "ddns $section" "missing WAN IPv4, LAN GUA or host id"
		continue
		;;
	esac

	answers=$(dns_answers "$ddns_resolver" "$host" "$qtype")
	case "
$answers
" in
	*"
$expected
"*) pass "ddns $section" "$host -> $expected" ;;
	*) fail "ddns $section" "$host does not publish $expected (got: $(printf '%s' "$answers" | tr '\n' ' '))" ;;
	esac
done

# mon and ban are in the zone as their ULAs. Static records, so unlike the DDNS
# ones they cannot drift with the prefix - but they can be deleted.
for pair in "$MON_NAME|$ULA" "ban.drasa.eu|$BAN_ULA"; do
	name=${pair%|*}
	want=${pair#*|}
	answers=$(dns_answers "$ddns_resolver" "$name" AAAA)
	case "
$answers
" in
	*"
$want
"*) pass "zone $name" "$want" ;;
	*) fail "zone $name" "public AAAA is not $want (got: $(printf '%s' "$answers" | tr '\n' ' '))" ;;
	esac
done

exit "$bad"
