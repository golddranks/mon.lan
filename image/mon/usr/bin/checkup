#!/bin/sh
# Regression checks for the invariants this repo's mon configuration is built
# around.
#
# Expectations are hard-coded below. Deployment values - the ULA prefix from
# uci, the LAN prefix from netifd's prefix assignment - are read at run time,
# because they are operator and ISP data, not invariants. If the design changes,
# this file has to change with it, and a stale copy here will report FAIL with
# confidence.
#
# `[value]` lines are observations, not checks: mon-watch remembers them and
# mails when one changes, so a renumbering that stays healthy is still visible.
#
# Not covered: ACME renewal itself (only the certificate it produced is
# checked), cafe's own services beyond a TCP handshake, the NAT64 datapath when
# ban is offline (the datapath check needs a host on the LAN), and the jail,
# whose devices cannot be driven from here. The outside group needs hato and
# reports skip for all of its checks when it is away; the VPN group skips until
# hato has a tunnel of its own.
#
# Read-only. Exit status is 1 if any check fails.

WAN_DEV="eth1"
LAN_DEV="br-lan"
MON_NAME="mon.drasa.eu"
BAN_NAME="ban.drasa.eu"
CAFE_NAME="cafe.drasa.eu"
WEB_NAME="share.drasa.eu"
LLM_NAME="llm.drasa.eu"
HATO="hato.drasa.eu"
ula_stem=$(uci -q get network.globals.ula_prefix | sed 's|::/[0-9]*$||')
ULA="$ula_stem::1"
BAN_ULA="$ula_stem::2"
CAFE_ULA="$ula_stem::cafe"
BEAD_ULA="$ula_stem::bead"
PREFIX_STEM="64:ff9b::"
JOOL_INSTANCE="nat64"
CERT_MIN_DAYS=14
NIXOS_PIN_MAX_LAG_DAYS=3
NIXOS_HOST_MAX_LAG_DAYS=1
SPACE_MAX_PCT=90
GHOST_KEY="/root/.ssh/id_ed25519"

bad=0

# Labels are padded to 20 columns because mon-watch parses them at that width to
# tell which checks are failing, and `[value]` lines at the same width to tell
# which value changed. Keep every label at 20 characters or fewer.
pass() { printf '[PASS] %-20s %s\n' "$1" "$2"; }
fail() {
	printf '[FAIL] %-20s %s\n' "$1" "$2"
	bad=1
}
info() { printf '[info] %-20s %s\n' "$1" "$2"; }
skip() { printf '[skip] %-20s %s\n' "$1" "$2"; }
value() { printf '[value] %-20s %s\n' "$1" "$2"; }
group() { printf '\n== %s ==\n' "$1"; }

[ -n "$ula_stem" ] ||
	fail "ula prefix" "network.globals.ula_prefix is unset; ULA checks are meaningless"

# Answers for a name, one per line; the resolver's own "Address: x:53" dropped.
# $3 is an optional query type (A, AAAA).
dns_answers() {
	if [ -n "${3-}" ]; then
		nslookup -type="$3" "$2" "$1" 2>/dev/null |
			sed -n 's/^Address:[[:space:]]*//p' | grep -vxF "$1:53"
	else
		nslookup "$2" "$1" 2>/dev/null |
			sed -n 's/^Address:[[:space:]]*//p' | grep -vxF "$1:53"
	fi
}

http_code() { curl -s -o /dev/null -w '%{http_code}' --max-time 8 "$@" 2>/dev/null; }

# One key=value line out of a batch of remote output.
field() { printf '%s\n' "$1" | sed -n "s/^$2=//p" | head -n 1; }

on_ban() {
	ssh -T -i "$GHOST_KEY" "ghost@$BAN_ULA" "$1" 2>/dev/null </dev/null
}

# Runs one command on a NixOS host as ghost. dbclient has no connect timeout and
# this busybox has no `timeout`, so the call is capped here: a wedged host must
# not stall a cron run. Everything sent over the call carries its own limit
# (curl --max-time, nc -w, ping -w).
on_host() {
	out=/tmp/checkup.ssh.$$
	ssh -T -i "$GHOST_KEY" "ghost@$1" "$2" >"$out" 2>/dev/null </dev/null &
	pid=$!
	# The killer's stdio is redirected: it outlives this function when the call
	# returns early, and anything it holds open would keep a caller's $(...)
	# from finishing for the rest of the sleep.
	{ sleep 20; kill "$pid" 2>/dev/null; } >/dev/null 2>&1 &
	killer=$!
	wait "$pid" 2>/dev/null
	kill "$killer" 2>/dev/null
	cat "$out"
	rm -f "$out"
}

# hato is the only vantage point outside the line.
on_hato() { on_host "$HATO" "$1"; }

# --- identity ---------------------------------------------------------------
group identity
release=$(sed -n "s/^DISTRIB_DESCRIPTION='\(.*\)'/\1/p" /etc/openwrt_release)
info "image" "${release:-unknown}"

wan4=$(ubus call network.interface.wan status 2>/dev/null |
	jsonfilter -e '@["ipv4-address"][0].address' 2>/dev/null | head -n 1)
wan6_addr=$(ubus call network.interface.wan6 status 2>/dev/null |
	jsonfilter -e '@["ipv6-address"][0].address' 2>/dev/null | head -n 1)

# --- WAN and delegation -----------------------------------------------------
group wan
wan6_status=$(ubus call network.interface.wan6 status 2>/dev/null)
pd_addr=$(printf '%s' "$wan6_status" |
	jsonfilter -e '@["ipv6-prefix"][0].address' 2>/dev/null)
pd_mask=$(printf '%s' "$wan6_status" |
	jsonfilter -e '@["ipv6-prefix"][0].mask' 2>/dev/null)

if [ -n "$wan4" ]; then
	pass "wan ipv4" "$wan4"
else
	fail "wan ipv4" "no global address on $WAN_DEV"
fi

if [ -n "$pd_addr" ]; then
	pass "delegated prefix" "$pd_addr/$pd_mask"
else
	fail "delegated prefix" "wan6 has no ipv6-prefix"
fi
value "pd" "${pd_addr:-none}/${pd_mask:-0}"

if [ "$pd_mask" = "56" ]; then
	pass "prefix length" "/56 as requested"
else
	fail "prefix length" "expected 56, got '${pd_mask:-none}'"
fi

# --- LAN addressing ---------------------------------------------------------
group lan
lan6=$(ip -6 -o addr show dev "$LAN_DEV" scope global 2>/dev/null |
	sed -n 's/.* inet6 \([0-9a-fA-F:]*\)\/.*/\1/p')
lan6_list=$(printf '%s' "$lan6" | tr '\n' ' ')

if [ -n "$(ip -4 -o addr show dev "$LAN_DEV" 2>/dev/null)" ]; then
	fail "lan ipv4" "$LAN_DEV has an IPv4 address; the LAN must be v6-only"
else
	pass "lan ipv4" "none on $LAN_DEV"
fi

case " $lan6_list " in
*" $ULA "*) pass "lan ula" "$ULA" ;;
*) fail "lan ula" "expected $ULA on $LAN_DEV, have: $lan6_list" ;;
esac

# The LAN /64 is whatever netifd took from the delegation, not a value written
# down in this repo. A static GUA survives a PD change and stays plausible while
# the ISP routes nothing, so the address on br-lan is checked against the
# assignment. The ULA is an assignment too: skip it, or the check compares the
# LAN GUA against the ULA.
if [ -n "$ula_stem" ]; then
	lan_pd=$(ubus call network.interface.lan status 2>/dev/null |
		jsonfilter -e '@["ipv6-prefix-assignment"][*].address' 2>/dev/null |
		grep -v "^${ula_stem}" | head -n 1)
fi
lan_pd_stem=$(printf '%s' "$lan_pd" | sed 's/:*$//')

lan_gua=
for a in $lan6; do
	case "$a" in
	"$ula_stem"*) continue ;;
	esac
	if [ -n "$lan_pd_stem" ] &&
		[ "$(printf '%s' "$a" | cut -d: -f1-4)" = "$lan_pd_stem" ]; then
		lan_gua=$a
		break
	fi
done

if [ -z "$lan_pd_stem" ]; then
	fail "lan prefix" "netifd assigned no prefix from the delegation to $LAN_DEV"
elif [ -z "$lan_gua" ]; then
	fail "lan gua" "no address inside $lan_pd/64 on $LAN_DEV; have: $lan6_list"
else
	pass "lan gua" "$lan_gua from $lan_pd/64"
fi
value "lan gua" "${lan_gua:-none}"

# Clients get their addresses from the prefix odhcpd advertises, so a bound
# lease inside the delegation is the consequence of the assignment actually
# reaching the LAN. A stale advertised prefix leaves every lease outside it.
lease_lines=$(ubus call dhcp ipv6leases 2>/dev/null |
	jsonfilter -e '@["device"]["br-lan"]["leases"][*]' 2>/dev/null)
lease_counts=$(printf '%s\n' "$lease_lines" | awk -v stem="$lan_pd_stem" '
	/"bound"/ {
		bound++
		if (stem != "" && index($0, stem ":") > 0) inpd++
	}
	END { print bound + 0, inpd + 0 }')
bound_leases=${lease_counts% *}
leases_in_pd=${lease_counts#* }
if [ "$bound_leases" -eq 0 ]; then
	fail "dhcpv6 leases" "no bound leases on $LAN_DEV"
elif [ -z "$lan_pd_stem" ] || [ "$leases_in_pd" -eq 0 ]; then
	fail "dhcpv6 leases" "none of $bound_leases bound lease(s) is inside ${lan_pd:-the LAN /64}"
else
	pass "dhcpv6 leases" "$leases_in_pd of $bound_leases bound lease(s) inside $lan_pd/64"
fi

probe6="2606:4700:4700::1111"

# --- the prefix is actually routed upstream ---------------------------------
group upstream
# Holding a delegation means only that netifd has one. J:COM has stopped routing
# ours while the lease still looked valid for days, and every check above stayed
# green. Ping out sourced from the LAN GUA: same next hop, but the source is what
# an ISP filters on. The WAN-sourced probe is the control, so a dead uplink is
# reported as such instead of as a bad prefix. Three packets each: a working
# prefix has lost its first one in testing.
if [ -z "$lan_gua" ] || [ -z "$wan6_addr" ]; then
	skip "lan-sourced egress" "need both a LAN GUA and a WAN IPv6 address"
elif ! ping6 -c 3 -W 2 -I "$wan6_addr" "$probe6" >/dev/null 2>&1; then
	fail "lan-sourced egress" "no uplink at all: $wan6_addr cannot reach $probe6"
elif ping6 -c 3 -W 2 -I "$lan_gua" "$probe6" >/dev/null 2>&1; then
	pass "lan-sourced egress" "$lan_gua -> $probe6"
else
	fail "lan-sourced egress" "$lan_gua gets no reply while $wan6_addr does: the prefix is not routed upstream"
fi

# --- names ------------------------------------------------------------------
group names
dns64=$(nslookup ipv4only.arpa 127.0.0.1 2>/dev/null |
	grep -o "${PREFIX_STEM}[0-9a-fA-F:]*" | head -n 1)
if [ -n "$dns64" ]; then
	pass "dns64" "ipv4only.arpa -> $dns64"
else
	fail "dns64" "no synthesised AAAA from the local resolver"
fi

for pair in "$MON_NAME|$ULA" "mon.lan|$ULA" "ban.lan|$BAN_ULA" \
	"ban.drasa.eu|$BAN_ULA" "bead.lan|$BEAD_ULA" \
	"bead.drasa.eu|$BEAD_ULA" "llm.drasa.eu|$BEAD_ULA"; do
	name=${pair%|*}
	want=${pair#*|}
	answers=$(dns_answers 127.0.0.1 "$name")
	case "
$answers
" in
	*"
$want
"*) pass "name $name" "$want" ;;
	*) fail "name $name" "expected $want, got: $(printf '%s' "$answers" | tr '\n' ' ')" ;;
	esac
done

# --- hosts ------------------------------------------------------------------
group hosts
if ping6 -c 1 -W 1 "$BAN_ULA" >/dev/null 2>&1; then
	pass "ban reachable" "$BAN_ULA"
else
	fail "ban reachable" "no echo reply from $BAN_ULA"
fi

# The AP must not form a GUA: mon forwards 80/443 to the LAN zone, so any
# address on ban that is not the ULA would be reachable from the internet.
if [ ! -f "$GHOST_KEY" ]; then
	skip "ban no gua" "no ghost key at $GHOST_KEY"
elif ! ping6 -c 1 -W 1 "$BAN_ULA" >/dev/null 2>&1; then
	skip "ban no gua" "ban is offline"
else
	ban_guas=$(on_ban 'ip -6 addr show dev br-lan' |
		sed -n 's/^ *inet6 \([0-9a-fA-F:]*\)\/.* scope global.*/\1/p' |
		grep -v "^${ula_stem}" | tr '\n' ' ')
	if [ -z "$ban_guas" ]; then
		pass "ban no gua" "only the ULA"
	else
		fail "ban no gua" "GUA(s) on br-lan: $ban_guas"
	fi
fi

if ping6 -c 1 -W 1 "$BEAD_ULA" >/dev/null 2>&1; then
	pass "bead reachable" "$BEAD_ULA"
else
	fail "bead reachable" "no echo reply from $BEAD_ULA"
fi

# usteer trades node and station state with the other AP over the LAN, over IPv6.
# One entry per peer; empty means the instances cannot see each other, which is
# what happens when `option ipv6` is left at its default of 0.
peers=$(ubus -t 5 call usteer remote_hosts 2>/dev/null | grep -c '"id":')
if [ "${peers:-0}" -gt 0 ]; then
	pass "usteer peers" "$peers peer(s)"
else
	fail "usteer peers" "none; the APs are not exchanging state"
fi

# The jail's devices are only reachable through their DHCPv4 leases: dnsmasq
# renews a lease at half of its 12 h lifetime, so a device that stops answering
# loses the lease entirely. The lease file is under /tmp, so it is empty on
# every boot and a device reappears at its next renewal: until one renewal
# interval has passed, absence says nothing.
uptime_s=$(cut -d' ' -f1 /proc/uptime)
lease_now=$(date +%s)
for section in $(uci -q show dhcp |
	sed -n 's/^dhcp\.\(@host\[[0-9]*\]\)\.mac=.*/\1/p'); do
	name=$(uci -q get "dhcp.$section.name")
	mac=$(uci -q get "dhcp.$section.mac" | tr 'A-F' 'a-f')
	if [ "${uptime_s%%.*}" -lt 25200 ]; then
		skip "iot $name" "up for $(( ${uptime_s%%.*} / 3600 ))h; leases are still being rebuilt"
		continue
	fi
	exp=$(awk -v mac="$mac" -v now="$lease_now" '
		tolower($2) == mac && $1 + 0 > now { print $1; exit }' /tmp/dhcp.leases 2>/dev/null)
	if [ -n "$exp" ]; then
		pass "iot $name" "lease for another $(((exp - lease_now) / 3600))h"
	else
		fail "iot $name" "$mac holds no current lease on the jail"
	fi
done

# --- NAT64 ------------------------------------------------------------------
group nat64
# Jool only translates forwarded traffic, so mon cannot test its own translation:
# a ping from the router, or a connection to the router's own WAN address, never
# enters the forward hook. The probe therefore runs on ban, an ordinary host on
# the LAN whose packets are forwarded and translated like any client's.
#
# All three protocols are probed because pool4 holds a separate table per
# protocol: a missing row breaks that protocol alone, and the other two keep
# working.
if [ ! -f "$GHOST_KEY" ]; then
	skip "nat64 datapath" "no ghost key at $GHOST_KEY"
elif ! ping6 -c 1 -W 1 "$BAN_ULA" >/dev/null 2>&1; then
	skip "nat64 datapath" "ban is offline; the probe needs a host on the LAN"
else
	if on_ban '/usr/bin/ping -6 -c 1 -W 3 64:ff9b::808:808' >/dev/null 2>&1; then
		icmp=ok
	else
		icmp=no
	fi

	# A DNS query to 8.8.8.8 through NAT64 is the UDP path.
	if on_ban 'nslookup example.com 64:ff9b::808:808' | grep -q '^Name:'; then
		udp=ok
	else
		udp=no
	fi

	# busybox wget exits 8 when the server answers with an HTTP error, which is
	# still a completed TCP connection - that is all this probes.
	tcp_rc=$(on_ban 'wget -T 5 -O /dev/null "http://[64:ff9b::101:101]/" >/dev/null 2>&1; echo $?')
	case "$tcp_rc" in
	0 | 8) tcp=ok ;;
	*) tcp=no ;;
	esac

	if [ "$icmp$udp$tcp" = okokok ]; then
		pass "nat64 datapath" "icmp/udp/tcp from ban"
	else
		fail "nat64 datapath" "icmp=$icmp udp=$udp tcp=$tcp from ban"
	fi
fi

info "ephemeral ports" "$(sysctl -n net.ipv4.ip_local_port_range 2>/dev/null |
	tr -s ' \t' ' ')"
info "jool counters" "$(jool -i "$JOOL_INSTANCE" stats display 2>/dev/null |
	grep -E 'JSTAT_(BIB_ENTRIES|SESSIONS|POOL4_MISMATCH):' | tr '\n' ' ')"

# --- enforcement ------------------------------------------------------------
group enforcement
# A lint until an external probe exists (a host outside the WAN trying 22/80/443
# is the real consequence). It reads the wan input chain, so it also catches a
# rule that opens the router itself.
input_wan=$(nft list chain inet fw4 input_wan 2>/dev/null)
input_open=$(printf '%s\n' "$input_wan" | awk '
	/comment/ { sub(/comment ".*/, "") }
	/nfproto ipv4/ { next }
	/accept/ && /tcp dport/ {
			sub(/.*tcp dport[ ]+/, "")
			sub(/[ ](counter|accept|jump|drop|reject|return).*/, "")
			gsub(/[{},]/, " ")
			print
	}' | tr ' ' '\n' | grep -xE '22|80|443' | sort -un | tr '\n' ' ')

if [ -n "$input_open" ]; then
	fail "fw v6 input" "accepted from WAN: $input_open"
elif [ -z "$input_wan" ]; then
	fail "fw v6 input" "cannot read the wan input chain"
else
	pass "fw v6 input" "lint - no 22/80/443 accepted from WAN"
fi

# --- VPN --------------------------------------------------------------------
group vpn
# SkeletoriLanVPN is the only way into the LAN from outside, and a tunnel that
# is configured on both ends but never completes a handshake is indistinguishable
# from a working one when looked at from mon. The consequence is hato's: it joins
# the tunnel and addresses a host the way it would at home.
vpn_links=$(on_hato 'ip -o link show type wireguard 2>/dev/null')
if [ -z "$(on_hato 'echo ok')" ]; then
	skip "vpn lan path" "hato is unreachable"
	skip "vpn handshake" "hato is unreachable"
elif [ -z "$vpn_links" ]; then
	skip "vpn lan path" "hato has no WireGuard interface"
	skip "vpn handshake" "hato has no WireGuard interface"
else
	# `ping -6`, not `ping6`: hato's `ping6` is inetutils and rejects these
	# options outright, while iputils' `ping` has the privilege to open the socket.
	out=$(on_hato "ping -6 -c 2 -w 5 $CAFE_ULA >/dev/null 2>&1; echo vpn=\$?")
	vpn_rc=$(printf '%s\n' "$out" | sed -n 's/^vpn=//p')
	if [ "$vpn_rc" = 0 ]; then
		pass "vpn lan path" "$CAFE_ULA from hato through the tunnel"
	else
		fail "vpn lan path" "hato gets no reply from $CAFE_ULA over the tunnel"
	fi

	# The ping above is what makes mon rekey; the peer's own timestamp is the
	# proof that the handshake completed rather than the packets being dropped.
	hs=$(wg show lan_vpn latest-handshakes 2>/dev/null |
		awk '{ print $2 }' | sort -n | tail -n 1)
	age=$(($(date +%s) - ${hs:-0}))
	if [ "${hs:-0}" -gt 0 ] && [ "$age" -lt 300 ]; then
		pass "vpn handshake" "lan_vpn handshook ${age}s ago"
	else
		fail "vpn handshake" "no handshake on lan_vpn within 5 minutes"
	fi
fi

# SkeletoriJailVPN is the other direction: traffic leaves the line as if it came
# from home, and nothing private is reachable through it. The client is whichever
# hato interface holds an address in the jail's subnet.
jail_if=$(on_hato "ip -4 -o addr show | grep 'inet 10[.]10[.]2[.]' | cut -d' ' -f2 | head -n 1")
if [ -z "$(on_hato 'echo ok')" ]; then
	skip "jail vpn egress" "hato is unreachable"
	skip "jail vpn lan" "hato is unreachable"
elif [ -z "$jail_if" ]; then
	skip "jail vpn egress" "hato has no interface in 10.10.2.0/24"
	skip "jail vpn lan" "hato has no interface in 10.10.2.0/24"
else
	# Egress needs the zone's forward to the WAN and its masquerade: the reply
	# has to come back to hato's private address through the same translation.
	out=$(on_hato "ping -4 -I $jail_if -c 2 -w 5 8.8.8.8 >/dev/null 2>&1; echo rc=\$?")
	if [ "$(field "$out" rc)" = 0 ]; then
		pass "jail vpn egress" "8.8.8.8 through $jail_if"

		# Silence on a private address only means isolation while egress works;
		# a dead tunnel is silent for both.
		out=$(on_hato "ping -4 -I $jail_if -c 1 -w 3 10.10.1.1 >/dev/null 2>&1; echo rc=\$?")
		if [ "$(field "$out" rc)" = 0 ]; then
			fail "jail vpn lan" "10.10.1.1 answers through $jail_if"
		else
			pass "jail vpn lan" "10.10.1.1 unreachable through $jail_if"
		fi
	else
		fail "jail vpn egress" "no reply through $jail_if; the jail VPN is not forwarding"
		skip "jail vpn lan" "no egress to prove the tunnel carries anything"
	fi
fi

# --- web and TLS ------------------------------------------------------------
group web
code=$(http_code -k "https://[$ULA]/")
if [ "$code" = "200" ]; then
	pass "luci https" "200 on [$ULA]"
else
	fail "luci https" "expected 200 on [$ULA], got '$code'"
fi

code=$(http_code "http://[$ULA]/")
if [ "$code" = "301" ]; then
	pass "http redirect" "301 to https"
else
	fail "http redirect" "expected 301 on [$ULA], got '$code'"
fi

code=$(http_code "https://$MON_NAME/")
if [ "$code" = "200" ]; then
	pass "tls verified" "$MON_NAME validates against the CA bundle"
else
	fail "tls verified" "expected 200 with a valid cert, got '$code'"
fi

if openssl s_client -connect "[$ULA]:443" -servername "$MON_NAME" </dev/null 2>/dev/null |
	openssl x509 -checkend "$((CERT_MIN_DAYS * 86400))" -noout >/dev/null 2>&1; then
	pass "cert expiry" "valid for more than $CERT_MIN_DAYS days"
else
	fail "cert expiry" "certificate expires within $CERT_MIN_DAYS days"
fi

# ban has no release process of its own: mon stages the certificate under
# /etc/ssl/ban and ban's own init script installs it, so this is the only place
# that sees whether that hand-off worked.
if openssl s_client -connect "[$BAN_ULA]:443" -servername "$BAN_NAME" </dev/null 2>/dev/null |
	openssl x509 -checkend "$((CERT_MIN_DAYS * 86400))" -noout >/dev/null 2>&1; then
	pass "ban cert" "$BAN_NAME valid for more than $CERT_MIN_DAYS days"
else
	fail "ban cert" "no usable certificate on [$BAN_ULA]"
fi

code=$(http_code -k "https://[$CAFE_ULA]/")
if [ "$code" != "000" ] && [ -n "$code" ]; then
	pass "cafe 443" "$code from [$CAFE_ULA]"
else
	fail "cafe 443" "no answer from [$CAFE_ULA]"
fi

# bead's LLM vhost proxies to a server that listens on loopback only, so an
# answer here is the service being alive behind nginx rather than nginx alone.
# The service is restarted twice a night and answers 503 while the model loads,
# so that window is a skip. The timeout is generous because a request that
# arrives during warm-up can sit for tens of seconds before it is answered.
body=/tmp/checkup.bead.$$
code=$(curl -s -o "$body" -w '%{http_code}' --max-time 30 -k \
	--resolve "$LLM_NAME:443:$BEAD_ULA" "https://$LLM_NAME/" 2>/dev/null)
case "$code" in
200) pass "bead http" "$LLM_NAME via [$BEAD_ULA]" ;;
503)
	if grep -q 'Loading model' "$body"; then
		skip "bead http" "the model is loading"
	else
		fail "bead http" "503 without a loading message"
	fi
	;;
000 | '') fail "bead http" "no answer from $LLM_NAME" ;;
*) fail "bead http" "expected 200 from $LLM_NAME, got '$code'" ;;
esac
rm -f "$body"

# bead issues its own certificates, so this is the one place that sees whether
# its renewal works; mon's own cert is checked above.
if openssl s_client -connect "[$BEAD_ULA]:443" -servername "$LLM_NAME" </dev/null 2>/dev/null |
	openssl x509 -checkend "$((CERT_MIN_DAYS * 86400))" -noout >/dev/null 2>&1; then
	pass "bead cert" "$LLM_NAME valid for more than $CERT_MIN_DAYS days"
else
	fail "bead cert" "no usable certificate on [$BEAD_ULA]"
fi

if [ -n "$wan4" ]; then
	code=$(http_code -k --resolve "$WEB_NAME:443:$wan4" "https://$WEB_NAME/")
	if [ "$code" = "200" ]; then
		pass "v4 web path" "$WEB_NAME via $wan4:443 -> cafe"
	else
		fail "v4 web path" "expected 200 via $wan4:443, got '$code'"
	fi
else
	skip "v4 web path" "no WAN IPv4"
fi

# --- wireless and NTP -------------------------------------------------------
group wireless
radios_up=$(ubus call network.wireless status 2>/dev/null |
	jsonfilter -e '@.*.up' | grep -c true)
if [ "$radios_up" = "2" ]; then
	pass "wireless" "2 radios up"
else
	fail "wireless" "$radios_up radios up, expected 2"
fi

want_ssid=$(uci -q get wireless.@wifi-iface[0].ssid)
jail_ssid=$(uci -q get wireless.jail_radio0.ssid)
wifi_status=$(ubus call network.wireless status 2>/dev/null)
main_on=$(printf '%s' "$wifi_status" |
	jsonfilter -e '@.*.interfaces[*].config.ssid' | grep -cxF "$want_ssid")
jail_on=$(printf '%s' "$wifi_status" |
	jsonfilter -e '@.*.interfaces[*].config.ssid' | grep -cxF "$jail_ssid")
jail_on_24=$(printf '%s' "$wifi_status" |
	jsonfilter -e '@.radio0.interfaces[*].config.ssid' | grep -cxF "$jail_ssid")
# The main SSID on both radios; the jail on 2.4 GHz only, which is what keeps
# it out of the 5 GHz airtime and out of ban, whose uplink cannot carry it.
if [ "$main_on" = "2" ] && [ "$jail_on" = "1" ] && [ "$jail_on_24" = "1" ]; then
	pass "ssid" "$want_ssid x2, $jail_ssid on radio0"
else
	fail "ssid" "$want_ssid on $main_on radio(s), $jail_ssid on $jail_on ($jail_on_24 on radio0)"
fi

# ban has no RTC, so its clock is right only if it took the time from mon since
# it booted. Comparing the two is the consequence of the NTP server.
ban_s=$(on_ban 'date +%s' | tr -d '\r')
mon_s=$(date +%s)
case "$ban_s" in
'' | *[!0-9]*)
	skip "ban clock" "ban did not report a time"
	;;
*)
	skew=$((ban_s - mon_s))
	[ "$skew" -lt 0 ] && skew=$((-skew))
	if [ "$skew" -lt 120 ]; then
		pass "ban clock" "${skew}s from mon"
	else
		fail "ban clock" "${skew}s from mon; ban is not taking time from the router"
	fi
	;;
esac

# --- published DNS ----------------------------------------------------------
group dns
# Recursive resolvers keep serving the old rrset for up to the zone TTL after a
# renumber, so ask the zone's own nameservers instead: they always have the
# current data.
ddns_domain=$(uci -q get ddns.cafe_a.domain)
ddns_resolver=1.1.1.1
if [ -n "$ddns_domain" ]; then
	ns=$(nslookup -type=NS "$ddns_domain" 1.1.1.1 2>/dev/null |
		sed -n 's/.*nameserver = //p' | head -n 1)
	if [ -n "$ns" ]; then
		ns_addr=$(dns_answers 1.1.1.1 "$ns" A | head -n 1)
		[ -n "$ns_addr" ] && ddns_resolver=$ns_addr && ddns_ns=$ns
	fi
fi
info "ddns resolver" "$ddns_resolver${ddns_ns:+ ($ddns_ns, authoritative)}"

for section in $(uci -q show ddns |
	sed -n 's/^ddns\.\([^.=]*\)\.lookup_host=.*/\1/p'); do
	host=$(uci -q get "ddns.$section.lookup_host")
	if [ "$(uci -q get "ddns.$section.use_ipv6")" = "1" ]; then
		qtype=AAAA
		if [ "$(uci -q get "ddns.$section.ip_network")" = "wan6" ]; then
			expected="$wan6_addr"
		else
			# The AAAA is the LAN /64 plus the host id given to the section's
			# ip_script (`lan_suffix.sh bead` publishes ::bead).
			suffix=$(uci -q get "ddns.$section.ip_script" | awk '{ print $NF }')
			expected=
			[ -n "$suffix" ] &&
				expected="$(printf '%s' "${lan_gua:-}" | cut -d: -f1-4)::$suffix"
		fi
	else
		suffix=
		expected="$wan4"
		qtype=A
	fi

	case "$expected" in
	'' | ::*)
		skip "ddns $section" "no address to publish"
		continue
		;;
	esac

	answers=$(dns_answers "$ddns_resolver" "$host" "$qtype")
	case "
$answers
" in
	*"
$expected
"*) pass "ddns $section" "$host -> $expected" ;;
	*) fail "ddns $section" "$host does not publish $expected (got: $(printf '%s' "$answers" | tr '\n' ' '))" ;;
	esac
done

# mon and ban are in the zone as their ULAs. Static records, so unlike the DDNS
# ones they cannot drift with the prefix - but they can be deleted.
for pair in "$MON_NAME|$ULA" "ban.drasa.eu|$BAN_ULA"; do
	name=${pair%|*}
	want=${pair#*|}
	answers=$(dns_answers "$ddns_resolver" "$name" AAAA)
	case "
$answers
" in
	*"
$want
"*) pass "zone $name" "$want" ;;
	*) fail "zone $name" "public AAAA is not $want (got: $(printf '%s' "$answers" | tr '\n' ' '))" ;;
	esac
done

# --- from outside ------------------------------------------------------------
# hato is outside the line, so it is the one vantage point that sees this
# network the way a stranger does. Every check here is a consequence of the
# firewall or of what DNS publishes; mon's own view of the same names is above.
group pub

if [ -z "$(on_hato 'echo ok')" ]; then
	fail "pub vantage" "$HATO does not answer; the outside checks cannot run"
	for label in "wan4 input" "wan4 names" "wan6 input" "mon closed" "cafe" "bead" "lan ssh" "lan http" "ban closed"; do
		skip "pub $label" "hato is unreachable"
	done
else
	pass "pub vantage" "$HATO answers"
	# IPv4 is one address shared by the line, so which host answers on it is a
	# policy question: the router keeps 22 and redirects 80, and 443 belongs to
	# cafe.
	if [ -z "$wan4" ]; then
		skip "pub wan4 input" "no WAN IPv4"
	else
		out=$(on_hato "ping -c 1 -w 2 $wan4 >/dev/null 2>&1; echo icmp=\$?
			nc -z -w 3 $wan4 22 >/dev/null 2>&1; echo s22=\$?
			curl -sS -o /dev/null -w 'http=%{http_code}\n' --max-time 6 http://$wan4/
			curl -sS -o /dev/null -w 'cafe=%{http_code}\n' --max-time 6 --resolve $CAFE_NAME:443:$wan4 https://$CAFE_NAME/")
		icmp=$(field "$out" icmp)
		s22=$(field "$out" s22)
		http4=$(field "$out" http)
		cafe4=$(field "$out" cafe)
		if [ "$icmp" = 0 ] && [ "$s22" != 0 ] && [ "$http4" = 301 ] && [ "$cafe4" = 200 ]; then
			pass "pub wan4 input" "$wan4: ICMP answers, 22 refused, 80 redirects, 443 is cafe"
		else
			fail "pub wan4 input" "$wan4: icmp=${icmp:-?} 22=${s22:-?} 80=${http4:-?} 443=${cafe4:-?}"
		fi
	fi

	# The stream map is closed: a name it does not list has to fail its
	# handshake rather than reach a default backend.
	if [ -n "$wan4" ]; then
		out=$(on_hato "curl -sS -o /dev/null -w '%{http_code}' --max-time 6 --resolve unlisted.example:443:$wan4 https://unlisted.example/")
		case "$out" in
		'' | 000) pass "pub wan4 names" "unlisted SNI refused on $wan4:443" ;;
		*) fail "pub wan4 names" "unlisted SNI answered '$out'" ;;
		esac
	fi

	# In IPv6 the address is mon's own, so nothing of cafe's may answer on it.
	# The address comes from DHCPv6 and can move; ICMP is the liveness control
	# that separates "refuses" from "this run has a stale address".
	case "$wan6_addr" in
	'') skip "pub wan6 input" "no WAN IPv6" ;;
	*[!0-9a-fA-F:]*) skip "pub wan6 input" "unexpected WAN address '$wan6_addr'" ;;
	*)
		out=$(on_hato "ping -6 -c 1 -w 2 $wan6_addr >/dev/null 2>&1; echo icmp=\$?
			nc -z -w 3 $wan6_addr 22 >/dev/null 2>&1; echo s22=\$?
			nc -z -w 3 $wan6_addr 80 >/dev/null 2>&1; echo s80=\$?
			nc -z -w 3 $wan6_addr 443 >/dev/null 2>&1; echo s443=\$?")
		icmp=$(field "$out" icmp)
		s22=$(field "$out" s22)
		s80=$(field "$out" s80)
		s443=$(field "$out" s443)
		if [ "$icmp" != 0 ]; then
			fail "pub wan6 input" "$wan6_addr does not answer ICMP from outside (address moved?)"
		elif [ "$s22" = 0 ] || [ "$s80" = 0 ] || [ "$s443" = 0 ]; then
			fail "pub wan6 input" "mon's own address answers: 22=${s22:-?} 80=${s80:-?} 443=${s443:-?}"
		else
			pass "pub wan6 input" "$wan6_addr: ICMP answers, 22/80/443 refuse"
		fi
		;;
	esac

	# The AAAA is a ULA, which nothing outside the LAN can route, so what the zone
	# publishes is the whole assertion. hato joins the LAN through SkeletoriLanVPN
	# and reaches these names that way, so probing them from there proves nothing.
	# One call per query: a multi-line command ending in `| sed` returned nothing
	# through on_hato here, reproducibly, and the cause was never found.
	for pair in "$MON_NAME|$ULA" "$BAN_NAME|$BAN_ULA"; do
		name=${pair%|*}
		want=${pair#*|}
		label=${name%%.*}
		a=$(on_hato "dig +short A $name")
		aaaa=$(on_hato "dig +short AAAA $name")
		if [ -z "$a" ] && [ "$aaaa" = "$want" ]; then
			pass "pub $label closed" "$name is AAAA-only ($want)"
		else
			fail "pub $label closed" "A='$a' AAAA='${aaaa:-none}'"
		fi
	done

	# cafe's certificate is what v6 clients verify when they follow the DNS, so the
	# family is pinned: left free, curl reaches cafe over IPv4 and proves nothing.
	code=$(on_hato "curl -sS -6 -o /dev/null -w '%{http_code}' --max-time 8 https://$CAFE_NAME/")
	if [ "$code" = 200 ]; then
		pass "pub cafe" "200 over IPv6 with a verified certificate"
	else
		fail "pub cafe" "expected 200 over IPv6 with a verified certificate, got '${code:-no answer}'"
	fi

	# bead's name publishes a GUA, so unlike mon and ban it has to answer from
	# outside: the record, the delegation's routing and the forward rule together.
	bead6=$(dns_answers "$ddns_resolver" "bead.drasa.eu" AAAA | head -n 1)
	if [ -z "$bead6" ]; then
		skip "pub bead" "bead.drasa.eu publishes no AAAA"
	else
		out=$(on_hato "ping -6 -c 2 -w 3 $bead6 >/dev/null 2>&1; echo rc=\$?")
		beadrc=$(field "$out" rc)
		if [ "$beadrc" = 0 ]; then
			pass "pub bead" "$bead6 answers echo requests"
		else
			fail "pub bead" "$bead6 does not answer; the published address is not routed"
		fi
	fi

	# LAN isn't meant to be reachable by SSH, and 80 is forwarded like 443: mon
	# redirects only on IPv4, so a browser following the AAAA reaches cafe's own
	# HTTP server.
	cafe6=$(on_hato "dig +short AAAA $CAFE_NAME | head -n 1")
	if [ -z "$cafe6" ]; then
		skip "pub lan ssh" "no AAAA for $CAFE_NAME"
		skip "pub lan http" "no AAAA for $CAFE_NAME"
	else
		# 443 is the control: if it does not answer, a silent 22 says nothing
		# about the firewall and everything about the address.
		out=$(on_hato "nc -z -w 3 $cafe6 443 >/dev/null 2>&1; echo s443=\$?
			nc -z -w 3 $cafe6 22 >/dev/null 2>&1; echo s22=\$?")
		s443=$(field "$out" s443)
		s22=$(field "$out" s22)
		if [ "$s443" != 0 ]; then
			skip "pub lan ssh" "$cafe6 answers on neither 443 nor 22"
		elif [ "$s22" != 0 ]; then
			pass "pub lan ssh" "22 refused on $cafe6"
		else
			fail "pub lan ssh" "$cafe6 answers on 22 from outside"
		fi

		out=$(on_hato "curl -sS -o /dev/null -w '%{http_code}' --max-time 6 -H 'Host: $CAFE_NAME' http://[$cafe6]/")
		if [ "$out" = 301 ]; then
			pass "pub lan http" "301 on $cafe6:80"
		else
			fail "pub lan http" "expected 301 on $cafe6:80, got '${out:-no answer}'"
		fi
	fi
fi

# --- out of date -------------------------------------------------------------
# Both boxes are OpenWrt images built from a pinned release, and the LAN's NixOS
# hosts are built from the flake.lock in nixos_configs, so "up to date" is not
# about a running process: it is whether the pinned release is still the current
# one, whether the hosts still run what the lock pins, and whether any host is
# sitting on an activated kernel or initrd it never booted.
#
# Upstream answers change on the scale of weeks, so they are fetched once a day
# into /tmp and parsed from there. A failed fetch keeps yesterday's copy; with
# no copy at all the checks skip, because unknown is not current.
group versions

CACHE=/tmp/checkup.cache
UPSTREAM_MAX_AGE=86400
mkdir -p "$CACHE"

# fetch <name> <url> refreshes $CACHE/<name> when it is missing or a day old.
fetch() {
	if [ -s "$CACHE/$1" ] && [ -n "$(cat "$CACHE/$1.stamp" 2>/dev/null)" ] &&
		[ $(($(date +%s) - $(cat "$CACHE/$1.stamp"))) -lt "$UPSTREAM_MAX_AGE" ]; then
		return 0
	fi
	if curl -sf --max-time 20 "$2" -o "$CACHE/$1.tmp"; then
		mv "$CACHE/$1.tmp" "$CACHE/$1"
		date +%s >"$CACHE/$1.stamp"
	fi
}

fetch openwrt https://downloads.openwrt.org/.versions.json
fetch nixos https://endoflife.date/api/nixos.json
fetch lock https://raw.githubusercontent.com/golddranks/nixos_configs/main/flake.lock

# What the hosts are built from. The workflow in that repo moves it daily.
pin_rev=$(jsonfilter -i "$CACHE/lock" -e '@.nodes.nixpkgs.locked.rev' 2>/dev/null)
pin_date=$(jsonfilter -i "$CACHE/lock" -e '@.nodes.nixpkgs.locked.lastModified' 2>/dev/null)

# The release's branch head as "<rev> <commit-epoch>", refreshed daily. The
# channel redirect names the rev; GitHub names the commit's date.
fetch_head() {
	cache="$CACHE/head.$1"
	if [ -s "$cache" ] && [ -n "$(cat "$cache.stamp" 2>/dev/null)" ] &&
		[ $(($(date +%s) - $(cat "$cache.stamp"))) -lt "$UPSTREAM_MAX_AGE" ]; then
		return 0
	fi
	final=$(curl -sIL --max-time 20 -o /dev/null -w '%{url_effective}' \
		"https://channels.nixos.org/nixos-$1/nixexprs.tar.xz" 2>/dev/null) || return 1
	head_rev=${final%/*}
	head_rev=${head_rev##*.}
	[ -n "$head_rev" ] || return 1
	curl -s --max-time 20 -o "$cache.raw" \
		"https://api.github.com/repos/NixOS/nixpkgs/commits/$head_rev" || return 1
	when=$(jsonfilter -i "$cache.raw" -e '@.commit.committer.date' 2>/dev/null)
	# busybox date does not take the ISO form Google returns; the commit date is
	# UTC, so it is parsed as such.
	when=$(printf '%s' "$when" | sed 's/T/ /; s/Z$//')
	epoch=$(date -u -d "$when" +%s 2>/dev/null)
	[ -n "$epoch" ] || return 1
	printf '%s %s\n' "$head_rev" "$epoch" >"$cache"
	date +%s >"$cache.stamp"
}

ow_stable=$(sed -n 's/.*"stable_version": *"\([^"]*\)".*/\1/p' "$CACHE/openwrt" 2>/dev/null | head -n 1)
[ -n "$ow_stable" ] && value "openwrt newest" "$ow_stable"

# A box on the current stable is up to date. One on the same branch but a patch
# behind is a heads-up; a box on an older branch gets nothing upstream anymore.
openwrt_check() {
	if [ -z "$2" ]; then
		skip "$1" "release unknown"
	elif [ -z "$ow_stable" ]; then
		skip "$1" "no upstream release list"
	elif [ "$2" = "$ow_stable" ]; then
		pass "$1" "$2 is the newest stable"
	elif [ "${2%.*}" = "${ow_stable%.*}" ]; then
		info "$1" "$ow_stable is out; this box is on $2"
	else
		fail "$1" "$2 is a superseded branch; $ow_stable is current"
	fi
}

openwrt_check "openwrt mon" "$(sed -n "s/^DISTRIB_RELEASE='\(.*\)'/\1/p" /etc/openwrt_release)"
openwrt_check "openwrt ban" "$(on_ban 'grep DISTRIB_RELEASE /etc/openwrt_release' | sed "s/.*='\(.*\)'/\1/")"

# Each NixOS host reports the build it runs, what it booted and when, then one
# "<percent> <mount> <device>" line per real filesystem. The comparison is
# against the profile rather than /run/current-system, to match should_reboot.sh
# in the nixos_configs repo.
nixos_facts() {
	# shellcheck disable=SC2016 # these commands expand on the host, not here
	on_host "$1" 'nixos-version
		readlink /run/booted-system/initrd /run/booted-system/kernel /run/booted-system/kernel-modules
		readlink /nix/var/nix/profiles/system/initrd /nix/var/nix/profiles/system/kernel /nix/var/nix/profiles/system/kernel-modules
		date -d @$(( $(date +%s) - $(cut -d. -f1 /proc/uptime) )) "+%F %R"
		stat -c %y /nix/var/nix/profiles/system | cut -c1-16
		df -P -l -x tmpfs -x devtmpfs -x efivarfs -x squashfs |
		awk '\''NR > 1 && !seen[$1]++ { p = $5; sub(/%/, "", p); print p, $6, $1 }'\'''
}

nixos_cycles=
nixos_check() {
	host=$1
	facts=$(nixos_facts "$2")
	printf '%s\n' "$facts" >"$CACHE/facts.$host"
	ver=$(printf '%s\n' "$facts" | sed -n '1p')
	if [ -z "$ver" ]; then
		skip "nixos $host" "$2 does not answer"
		return
	fi

	# `26.05.20261102.7dcdd87` carries the nixpkgs date, i.e. the pin this host
	# was built from; the lock's pin carries the date it should be on.
	stamp8=$(printf '%s' "$ver" | cut -d. -f3)
	behind=
	if [ ${#stamp8} -eq 8 ] && [ -n "${pin_date-}" ]; then
		built_on=$(printf '%s-%s-%s' \
			"$(printf '%s' "$stamp8" | cut -c1-4)" \
			"$(printf '%s' "$stamp8" | cut -c5-6)" \
			"$(printf '%s' "$stamp8" | cut -c7-8)")
		lag=$(( (pin_date - $(date -d "$built_on" +%s)) / 86400 ))
		if [ "$lag" -gt "$NIXOS_HOST_MAX_LAG_DAYS" ]; then
			behind="built $lag days before the lock's pin"
		fi
	fi

	booted_at=$(printf '%s\n' "$facts" | sed -n '8p')
	built_at=$(printf '%s\n' "$facts" | sed -n '9p')

	# Store paths carry no spaces, so the twins are compared as plain strings.
	booted_initrd=$(printf '%s\n' "$facts" | sed -n '2p')
	booted_kernel=$(printf '%s\n' "$facts" | sed -n '3p')
	booted_modules=$(printf '%s\n' "$facts" | sed -n '4p')
	built_initrd=$(printf '%s\n' "$facts" | sed -n '5p')
	built_kernel=$(printf '%s\n' "$facts" | sed -n '6p')
	built_modules=$(printf '%s\n' "$facts" | sed -n '7p')

	differs=
	[ "$booted_initrd" = "$built_initrd" ] || differs="$differs initrd"
	[ "$booted_kernel" = "$built_kernel" ] || differs="$differs kernel"
	[ "$booted_modules" = "$built_modules" ] || differs="$differs modules"

	problems=
	if [ -n "$behind" ]; then
		problems="$behind"
	fi
	if [ -n "$differs" ]; then
		what=$(printf '%s' "$differs" | sed 's/^ //; s/ /, /g')
		problems="${problems:+$problems, }a reboot is pending ($what): booted ${booted_at:-?}, profile built ${built_at:-?}"
	fi
	if [ -n "$problems" ]; then
		fail "nixos $host" "$ver: $problems"
	else
		pass "nixos $host" "$ver, on the lock's pin, running the current generation"
	fi

	nixos_cycles="$nixos_cycles $host:$(printf '%s' "$ver" | cut -d. -f1,2)"
}

nixos_check cafe "$CAFE_ULA"
nixos_check bead "$BEAD_ULA"
nixos_check hato "$HATO"

nixos_newest=
[ -s "$CACHE/nixos" ] && nixos_newest=$(tr '}' '\n' <"$CACHE/nixos" |
	sed -n 's/.*"cycle":"\([0-9.]*\)".*/\1/p' | head -n 1)
[ -n "$nixos_newest" ] && value "nixos newest" "$nixos_newest"

# Whether the lock is current is a question about the branch, not the calendar:
# a stable branch moves every few days, so its head can be a week old and still
# be the newest thing there is.
if [ -z "$pin_rev" ] || [ -z "$pin_date" ] || [ -z "$nixos_newest" ]; then
	skip "nixos pin" "no lockfile or no host answered"
elif ! fetch_head "$nixos_newest"; then
	skip "nixos pin" "no answer from channels.nixos.org"
else
	read -r head_rev head_epoch <"$CACHE/head.$nixos_newest"
	case "$pin_rev" in
	"$head_rev"*) pass "nixos pin" "the lock pins the $nixos_newest head" ;;
	*)
		pin_lag=$(((head_epoch - pin_date) / 86400))
		if [ "$pin_lag" -gt "$NIXOS_PIN_MAX_LAG_DAYS" ]; then
			fail "nixos pin" "the lock is $pin_lag days behind the $nixos_newest head ($(printf '%s' "$head_rev" | cut -c1-8))"
		else
			pass "nixos pin" "the lock is $pin_lag days behind the $nixos_newest head"
		fi
		;;
	esac
fi

# A fresh build from a branch that went end of life is still stale; the release
# dates are the only place that says so.
if [ -z "$nixos_cycles" ]; then
	skip "nixos release" "no host answered"
elif [ -z "$nixos_newest" ]; then
	skip "nixos release" "no upstream release list"
else
	dead=
	behind=
	newest_eol=
	today_s=$(date +%s)
	for pair in $nixos_cycles; do
		host=${pair%%:*}
		cycle=${pair#*:}
		eol=$(tr '}' '\n' <"$CACHE/nixos" |
			grep -F "\"cycle\":\"$cycle\"" |
			sed -n 's/.*"eol":"\([0-9-]*\)".*/\1/p' | head -n 1)
		eol_s=$(date -d "$eol" +%s 2>/dev/null)
		if [ -n "$eol_s" ] && [ "$eol_s" -lt "$today_s" ]; then
			dead="$dead $host($cycle)"
		fi
		if [ "$cycle" = "$nixos_newest" ]; then
			newest_eol=$eol
		else
			behind="$behind $host($cycle)"
		fi
	done
	if [ -n "$dead" ]; then
		fail "nixos release" "past end of life:$dead"
	elif [ -n "$behind" ]; then
		info "nixos release" "$nixos_newest is out;$behind still run an older release"
	else
		pass "nixos release" "$nixos_newest is supported (eol $newest_eol)"
	fi
fi

# --- disk space --------------------------------------------------------------
# A full filesystem takes everything else down with it, and nothing here would
# notice before it happened. Each filesystem is its own check: / can be
# comfortable while a 3 TB data disk is nearly full three bind mounts away.
group "disk space"

# Takes the "<percent> <mount> <device>" lines of one host.
space_checks() {
	host=$1
	if [ -z "$2" ]; then
		skip "$host" "no free-space answer"
		return
	fi
	while IFS= read -r line; do
		[ -n "$line" ] || continue
		pct=${line%% *}
		rest=${line#* }
		where=${rest%% *}
		dev=${rest#* }
		case "$pct" in
		'' | *[!0-9]*) continue ;;
		esac
		# mon-watch reads the label off the first 20 columns, so a path that
		# does not fit leaves the mountpoint to the value instead.
		label="$host $where"
		if [ ${#label} -le 20 ]; then
			msg="$pct% used"
		else
			label="$host $dev"
			msg="$pct% used on $where"
		fi
		if [ "$pct" -ge "$SPACE_MAX_PCT" ]; then
			fail "$label" "$msg"
		else
			pass "$label" "$msg"
		fi
	done <<EOF
$2
EOF
}

# busybox df has no -x, so /rom and the tmpfs rows are filtered by mountpoint.
space_checks mon "$(df -P |
	awk 'NR > 1 && ($6 == "/" || $6 ~ /^\/mnt\//) { p = $5; sub(/%/, "", p); print p, $6, $1 }')"
for host in cafe bead hato; do
	space_checks "$host" "$(sed -n '10,$p' "$CACHE/facts.$host" 2>/dev/null)"
done

exit "$bad"
