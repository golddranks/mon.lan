#!/bin/sh
# set-lan-prefix <prefix>/64 - point the LAN GUA at a prefix the ISP routes.
# Run it when netdiag reports "lan-sourced egress" failing.
set -u
case "${1-}" in
*/64) ;;
*) echo "usage: ${0##*/} <prefix>/64" >&2; exit 1 ;;
esac
stem=$(printf '%s' "${1%/64}" | sed 's/:*$//')
gw=$(uci get network.lanroute.gateway)
old=$(uci get network.lanroute.source)
ula=$(uci -q get network.lan.ip6addr | tr ' ' '\n' | grep -v '^[23]')
[ -n "$ula" ] ||
	{ echo "${0##*/}: no ULA address in network.lan.ip6addr" >&2; exit 1; }

uci -q delete network.lan.ip6addr
for a in $ula; do uci add_list network.lan.ip6addr="$a"; done
uci add_list network.lan.ip6addr="${stem}::1/64"
uci set network.lanroute.source="${stem}::/64"
uci commit network

for a in $(ip -6 addr show dev br-lan scope global |
	awk '/inet6 [23]/ { print $2 }'); do
	[ "$(printf '%s' "${a%%/*}" | cut -d: -f1-4)" = "$stem" ] ||
		ip -6 addr del "$a" dev br-lan
done
ip -6 addr replace "${stem}::1/64" dev br-lan nodad
ip -6 route del default via "$gw" dev eth1 from "$old" metric 1024 2>/dev/null
ip -6 route replace default via "$gw" dev eth1 from "${stem}::/64" metric 1024
/etc/init.d/odhcpd reload
