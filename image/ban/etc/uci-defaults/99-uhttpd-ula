#!/bin/sh
# ULA only: mon forwards 80/443 to LAN hosts, so a wildcard listener would
# put the admin UI on the internet. The IPv4 listeners go too: the LAN is
# IPv6-only.
uci -q delete uhttpd.main.listen_http
uci -q delete uhttpd.main.listen_https
uci add_list uhttpd.main.listen_http='[@ULA@::2]:80'
uci add_list uhttpd.main.listen_https='[@ULA@::2]:443'
uci commit uhttpd
