config system
	option hostname 'ban'
	option timezone 'JST-9'
	option zonename 'Asia/Tokyo'
	option ttylogin '0'
	option log_size '64'
	option urandom_seed '0'

# Time comes from mon, which serves NTP on the LAN. A public pool would resolve
# but never answer: this device has no globally routable address.
config timeserver 'ntp'
	option enabled '1'
	option enable_server '0'
	list server '@ULA@::1'
