# Copy to secrets.sed (gitignored) and fill in.
#
# Each non-comment line is a sed substitution applied to every file under
# image/. Values are sed replacement text: escape & as \& and pick a
# delimiter (here |) that does not appear in the value.

# Root password hash for @ROOT_PW_HASH@ (image/mon/etc/uci-defaults and
# image/ban/etc/uci-defaults):
#   Linux:  openssl passwd -6 'your-password'   (or mkpasswd -m sha512 'your-password')
#   macOS:  the system openssl is LibreSSL and lacks -6, so use
#           nix shell nixpkgs#openssl --command openssl passwd -6 'your-password'
#
# The whole string: SHA-512 crypt is $6$<salt>$<86-character digest>, and
# build.sh refuses anything that does not match that shape.
s|@ROOT_PW_HASH@|$6$REPLACE_ME|

# WiFi pre-shared key for the baked /etc/config/wireless (both radios).
# 8-63 printable ASCII characters.
s|@WIFI_PW@|REPLACE_ME|

# Pre-shared key for the jail SSID (SkeletorJail, 2.4 GHz, IPv4-only). Kept
# separate from the main PSK so an IoT credential cannot join the trusted SSID.
# Lowercase and digits only, 8 characters: it gets typed on a gamepad, and the
# jail is isolated and NATed, so this is not the primary secret.
s|@IOT_WIFI_PW@|REPLACE_ME|

# Gandi LiveDNS personal access token, used by ddns-scripts-gandi
# (see image/etc/config/ddns) and as the DNS-01 credential for Let's Encrypt
# (image/etc/config/acme).
s|@GANDI_API_KEY@|REPLACE_ME|

# Admin e-mail: the report recipient (baked into usr/libexec/mon-send) and the
# Let's Encrypt account (image/mon/etc/config/acme). The SMTP user is a separate
# account that owns the app password, set in image/mon/etc/msmtprc.
s|@ADMIN_EMAIL@|REPLACE_ME|

# API key for accessing llm.drasa.eu
s|@LLM_API_KEY@|REPLACE_ME|

# Gmail app password for msmtp (mon-send). 2-Step Verification is required;
# Google Account -> Security -> App passwords. The 16 characters only.
s|@SMTP_PASSWORD@|REPLACE_ME|
