# Copy to secrets.sed (gitignored) and fill in.
#
# Each non-comment line is a sed substitution applied to every file under
# image/. Values are sed replacement text: escape & as \& and pick a
# delimiter (here |) that does not appear in the value.

# Root password hash, used by the @ROOT_PW_HASH@ token in image/etc/uci-defaults:
#   Linux:  openssl passwd -6 'your-password'   (or mkpasswd -m sha512 'your-password')
#   macOS:  the system openssl is LibreSSL and lacks -6, so use
#           nix shell nixpkgs#openssl --command openssl passwd -6 'your-password'
#
# Paste the WHOLE result. A truncated hash matches no password at all and
# silently locks you out, so build.sh validates it - but check anyway that the
# digest is exactly 86 characters ($6$<salt>$<86 chars>).
s|@ROOT_PW_HASH@|$6$REPLACE_ME|

# WiFi pre-shared key for the baked /etc/config/wireless (both radios).
# 8-63 printable ASCII characters.
s|@WIFI_PW@|REPLACE_ME|

# Gandi LiveDNS personal access token, used by ddns-scripts-gandi
# (see image/etc/config/ddns) and as the DNS-01 credential for Let's Encrypt
# (image/etc/config/acme).
s|@GANDI_API_KEY@|REPLACE_ME|

# Let's Encrypt account email (acme; see image/etc/config/acme).
s|@ACME_EMAIL@|REPLACE_ME|
